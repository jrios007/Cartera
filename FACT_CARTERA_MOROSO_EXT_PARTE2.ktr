  <step>
    <name>MOROSOS</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>qxtransito</connection>
    <sql>select 
       CONSECUTIVO_MOROSOS
      , ID_USUARIO_MOROSO
      , NRO_COMPARENDO_MOROSO
      , TIPO_COMPARENDO
      , NUMERO_RES
      , FECHA_RESOLUCION
      , TIPO_SANCION
      , VALOR_MULTA 
      , ESTADO_MOROSO
      , FECHA_COMPARENDO
      , COBRO_COACTIVO
      , FECHA_COBRO_COACTIVO 
      , DESCRIPCION_ESTADO
      , NUMERO_PLACA
      , DESC_CLASE
      , DESC_SERVICIO
      , DESCRIPCION_COMPARENDO
      , NOMBRES
      , APELLIDOS
      , TELEFONO
      , DIRECCION
      
      --, IM.VALOR_INTERES AS VALOR_INTERES_MOROSOS
	  , 0 AS VALOR_INTERES_MOROSOS
      
      ,  PROCESAR_INTERES
      ,  FECHA_CUOTA
	  ,'S' VIGENTE

from (
select  PRO.ID_USUARIO_MOROSO
      , PRO.NRO_COMPARENDO_MOROSO
      , PRO.VALOR_MULTA 
      , PRO.ESTADO_MOROSO
      ,pro.consecutivo_morosos
      ,pro.Id_historico
      ,pro.indicativo
      ,pro.fecha_registro      
      ,CASE WHEN pro.Id_historico = MAX(pro.Id_historico) OVER (PARTITION BY pro.consecutivo_morosos)  THEN 'S' ELSE 'N' END as estado_actual
       --, mor.CONSECUTIVO_MOROSOS
      , mor.NUMERO_RES
      , (CASE WHEN nvl(mor.FECHA_RESOLUCION, to_date('01/01/1900','dd/mm/yyyy')) &lt; to_date('01/01/1900','dd/mm/yyyy')
        THEN to_date('01/01/1900','dd/mm/yyyy') ELSE mor.FECHA_RESOLUCION END) AS FECHA_RESOLUCION
      , mor.TIPO_SANCION
      , mor.COBRO_COACTIVO
      , mor.FECHA_COBRO_COACTIVO AS FECHA_COBRO_COACTIVO
      ,C.TIPO_COMPARENDO
      ,C.FECHA AS FECHA_COMPARENDO
      ,TEC.DESCRIPCION_ESTADO
      , C.NUMERO_PLACA AS NUMERO_PLACA
      , CV.DESC_CLASE AS DESC_CLASE
      , TS.DESC_SERVICIO AS DESC_SERVICIO
      , TIPO.DESCRIPCION AS DESCRIPCION_COMPARENDO
      , USU.NOMBRES
      , USU.APELLIDOS
      , USU.TELEFONO
      , USU.DIRECCION
      , (CASE WHEN C.FECHA >= to_date('16/03/2010','dd/mm/yyyy') THEN 1 ELSE 0 END ) AS PROCESAR_INTERES
      ,  NVL(APS.FECHA_CUOTA, to_date('01/01/1900','dd/mm/yyyy')) AS FECHA_CUOTA
from contravenciones_proceso pro
INNER JOIN morosos mor ON pro.consecutivo_morosos = mor.consecutivo_morosos 
LEFT JOIN ( -- Adicionamos la fecha de ultima cuota para ap, para generar la fecha de prescripcion proxima
            SELECT MORAP.consecutivo_morosos, max(cuo.fecha_pago_cuota) as FECHA_CUOTA
            FROM MOROSOS MORAP
              INNER JOIN AP_MAESTRO AP ON MORAP.numero_res = TO_CHAR(AP.nro_acuerdo) 
              INNER JOIN ap_detalle_cuotas CUO ON ap.consecutivo_ap = CUO.consecutivo_ap
            WHERE MORAP.FECHA_GENERACION &lt; TO_DATE(?,'YYYYMMDD HH24:MI:SS') AND MORAP.tipo_sancion = 'A'
            GROUP BY MORAP.consecutivo_morosos
          ) APS ON MOR.CONSECUTIVO_MOROSOS = APS.CONSECUTIVO_MOROSOS
INNER JOIN tipo_estado_comparendo TEC ON pro.estado_moroso = tec.estado_comparendo
LEFT JOIN COMPARENDOS C ON pro.NRO_COMPARENDO_MOROSO = C.NRO_COMPARENDO
LEFT JOIN LIC_TTO_CONTRAVENCIONES LC ON C.NUMERO_PLACA = LC.NUMERO_PLACA
LEFT JOIN CLASE_VEHICULOS CV ON LC.ID_CLASE = CV.ID_CLASE
LEFT JOIN TIPO_SERVICIO TS ON LC.ID_SERVICIO = TS.ID_SERVICIO
LEFT JOIN COMP_TIPO_COMPARENDO TIPO  ON TIPO.ID_TIPO_COMP = C.TIPO_COMPARENDO
LEFT JOIN USUARIOS_TTO USU ON USU.ID_USUARIO = pro.ID_USUARIO_MOROSO
where  pro.fecha_registro &lt; TO_DATE(?,'YYYYMMDD HH24:MI:SS')
--EXTRACT (YEAR from pro.fecha_registro ) = 2020
and pro.indicativo = 'M'
--and pro.estado_moroso IN ('1','2' ,'28' ,'18' )
and mor.TIPO_SANCION = 'A'
)pmo
where pmo.estado_moroso IN ('1','2' ,'28' ,'18' )
and pmo.estado_actual = 'S'
</sql>
    <limit>0</limit>
    <lookup>INFO_PARAMETROS</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
