    <replace_variables>N</replace_variables>
    <sql>

-- Ajuste por menor valor a actos administrativos ya reportados en cartera (actos administrativos en firme pendientes de pago)

BEGIN TRANSACTION


UPDATE FCR
SET FCR.Procesado = 1, FCR.Id_Tipo_Ajuste_Menor = AMV.Id_Tipo_Ajuste_Menor,  FCR.VALOR_AJUSTE_VALOR = AMV.VALOR_DIFERENCIA
FROM STA_AJUSTES_MENOR_VALOR AMV
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON AMV.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_MOROSOS_ESTADOS ES ON ES.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
WHERE FCR.Id_Tipo_Ajuste_Menor = 0
	--AND ES.ESTADO_MOROSO = 3

COMMIT

BEGIN TRANSACTION


UPDATE FCR
SET  FCR.Id_Tipo_Ajuste_Menor = (CASE WHEN FCR.VALOR_MULTA  &gt;  RCM.SUMADEVALOR_LIQUIDA THEN 9 ELSE 2 END),  
FCR.VALOR_AJUSTE_VALOR =  FCR.VALOR_MULTA - RCM.SUMADEVALOR_LIQUIDA,   VALOR_MULTA = RCM.SUMADEVALOR_LIQUIDA,
VALOR_MULTA_ACTUAL = RCM.SUMADEVALOR_LIQUIDA
FROM STA_STTM..[STA_RECAUDO_CARTERA_MOROSA] RCM
LEFT JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON RCM.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
WHERE RCM.SUMADEVALOR_LIQUIDA&lt;&gt;FCR.VALOR_MULTA

COMMIT

BEGIN TRANSACTION

  INSERT INTO [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS]
           ([CONSECUTIVO_MOROSO]
           ,[VALOR_MULTA]
           ,[PROCESADO]
           ,[ID_TIPO]
           ,[ID_TIPO_AJUSTE_MENOR])

SELECT 
	   CR.CONSECUTIVO_MOROSO
      ,P.VALOR_MULTA AS Valor_Multa
	  , 1 AS Procesado
	  , 63 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
FROM [STA_STTM].[dbo].STA_RECAUDO_CARTERA_MOROSA_REVIEW CR 
INNER JOIN (
SELECT CONSECUTIVO_MOROSO , SUMADEVALOR_PAGADO AS VALOR_MULTA FROM STA_STTM..STA_RECAUDO_CARTERA_MOROSA RCM
UNION ALL
SELECT CONSECUTIVO_MOROSO , VALOR_LIQUIDA AS VALOR_MULTA FROM STA_STTM..STA_PAGOS_SIMIT PS
) P ON CR.CONSECUTIVO_MOROSO = P.CONSECUTIVO_MOROSO
WHERE FECHA_LIQUIDA &gt;=  (select fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = &apos;Cartera_Contravenciones&apos;)
AND FECHA_REGISTRO &lt;(select fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = &apos;Cartera_Contravenciones&apos;)

COMMIT

BEGIN TRANSACTION

UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 61
FROM  [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR
INNER JOIN [STA_STTM].[dbo].STA_RECAUDO_CARTERA_MOROSA_REVIEW CR ON CR.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
WHERE Procesado = 0 AND FECHA_LIQUIDA &lt; (select fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = &apos;Cartera_Contravenciones&apos;)
AND FECHA_REGISTRO &gt;= (select fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = &apos;Cartera_Contravenciones&apos;)

COMMIT



BEGIN TRANSACTION

UPDATE [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS
SET Procesado = 1, ID_Tipo = 42 , VALOR_MULTA_ACTUAL = VALOR_MULTA
WHERE Procesado = 0
	AND ID_TIPO = 0

COMMIT


BEGIN TRANSACTION

UPDATE [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS
SET VALOR_MULTA_ACTUAL = VALOR_MULTA
WHERE VALOR_MULTA_ACTUAL IS NULL

COMMIT</sql>
