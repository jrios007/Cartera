    <sql>-- Envia los valores de morosos nuevos a la tabla valores resta
BEGIN TRANSACTION



 ---- definir concepto para cada tipo de pago
  INSERT INTO [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS]
           ([CONSECUTIVO_MOROSO]
           ,[VALOR_MULTA]
           ,[PROCESADO]
           ,[ID_TIPO]
           ,[ID_TIPO_AJUSTE_MENOR])


SELECT 
	   SCM.CONSECUTIVO_MOROSO
      ,SCM.VALOR_MULTA AS Valor_Multa
	  , 0 AS Procesadoa
	  , 0 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
FROM [STA_STTM].[dbo].STA_Fact_Cartera_Generada_Mes SCM
WHERE [ID_CLASE_ORIGEN] in (2,3,4)

COMMIT

/*SELECT 
	   SCM.CONSECUTIVO_MOROSO
      ,SCM.VALOR_MULTA AS Valor_Multa
	  , 0 AS Procesadoa
	  , 0 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
  FROM [STA_STTM].[dbo].STA_Fact_Cartera_Moroso SCM
  LEFT JOIN [STA_STTM].[dbo].STA_RECAUDO_CARTERA_MOROSA RCM ON RCM.CONSECUTIVO_MOROSO = SCM.CONSECUTIVO_MOROSO
  LEFT JOIN [STA_STTM].[dbo].STA_PAGOS_SIMIT PS ON SCM.CONSECUTIVO_MOROSO = PS.CONSECUTIVO_MOROSO
  LEFT JOIN STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR ON SCM.CONSECUTIVO_MOROSO = VR.CONSECUTIVO_MOROSO
  WHERE SCM.VIGENTE = 'N' AND VR.CONSECUTIVO_MOROSO IS NULL AND PS.CONSECUTIVO_MOROSO IS NOT NULL
  AND CASE WHEN  RCM.FECHA_GENERACION >= (SELECT fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')  THEN 'S' ELSE 'N' END  = 'S'
 UNION ALL  
 SELECT 
	   SCM.CONSECUTIVO_MOROSO
      ,SCM.VALOR_MULTA AS Valor_Multa
	  , 0 AS Procesadoa
	  , 0 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
  FROM [STA_STTM].[dbo].STA_Fact_Cartera_Moroso SCM
  LEFT JOIN [STA_STTM].[dbo].STA_RECAUDO_CARTERA_MOROSA RCM ON RCM.CONSECUTIVO_MOROSO = SCM.CONSECUTIVO_MOROSO
  LEFT JOIN [STA_STTM].[dbo].STA_PAGOS_SIMIT PS ON SCM.CONSECUTIVO_MOROSO = PS.CONSECUTIVO_MOROSO
  LEFT JOIN STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR ON SCM.CONSECUTIVO_MOROSO = VR.CONSECUTIVO_MOROSO
  WHERE SCM.VIGENTE = 'N' AND VR.CONSECUTIVO_MOROSO IS NULL AND PS.CONSECUTIVO_MOROSO IS NOT NULL
  AND CASE WHEN  RCM.FECHA_GENERACION >= (SELECT fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')  THEN 'S' ELSE 'N' END  = 'N'
 UNION ALL   
  SELECT 
	   SCM.CONSECUTIVO_MOROSO
      ,SCM.VALOR_MULTA AS Valor_Multa
	  , 0 AS Procesadoa
	  , 0 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
  FROM [STA_STTM].[dbo].STA_Fact_Cartera_Moroso SCM
  LEFT JOIN [STA_STTM].[dbo].STA_RECAUDO_CARTERA_MOROSA RCM ON RCM.CONSECUTIVO_MOROSO = SCM.CONSECUTIVO_MOROSO
  LEFT JOIN [STA_STTM].[dbo].STA_PAGOS_SIMIT PS ON SCM.CONSECUTIVO_MOROSO = PS.CONSECUTIVO_MOROSO
  LEFT JOIN STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR ON SCM.CONSECUTIVO_MOROSO = VR.CONSECUTIVO_MOROSO
  WHERE SCM.VIGENTE = 'N' AND VR.CONSECUTIVO_MOROSO IS NULL AND RCM.CONSECUTIVO_MOROSO IS NOT NULL
  AND CASE WHEN  RCM.FECHA_GENERACION >= (SELECT fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')  THEN 'S' ELSE 'N' END  = 'S'
 UNION ALL  
 SELECT 
	   SCM.CONSECUTIVO_MOROSO
      ,SCM.VALOR_MULTA AS Valor_Multa
	  , 0 AS Procesadoa
	  , 0 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor       
  FROM [STA_STTM].[dbo].STA_Fact_Cartera_Moroso SCM
  LEFT JOIN [STA_STTM].[dbo].STA_RECAUDO_CARTERA_MOROSA RCM ON RCM.CONSECUTIVO_MOROSO = SCM.CONSECUTIVO_MOROSO
  LEFT JOIN [STA_STTM].[dbo].STA_PAGOS_SIMIT PS ON SCM.CONSECUTIVO_MOROSO = PS.CONSECUTIVO_MOROSO
  LEFT JOIN STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR ON SCM.CONSECUTIVO_MOROSO = VR.CONSECUTIVO_MOROSO
  WHERE SCM.VIGENTE = 'N' AND VR.CONSECUTIVO_MOROSO IS NULL AND RCM.CONSECUTIVO_MOROSO IS NOT NULL
  AND CASE WHEN  RCM.FECHA_GENERACION >= (SELECT fecha_inicio FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')  THEN 'S' ELSE 'N' END  = 'N'
*/ 
--Actualiza el valor multa a valor pago 

BEGIN TRANSACTION

UPDATE FCM
SET FCM.VALOR_MULTA =  RCM.SUMADEVALOR_LIQUIDA
FROM [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RCM
INNER JOIN [STA_STTM].[dbo].STA_Fact_Cartera_Moroso FCM ON FCM.CONSECUTIVO_MOROSO = RCM.CONSECUTIVO_MOROSO
WHERE FCM.VIGENTE = 'N'
AND  FCM.VALOR_MULTA &lt;&gt;  RCM.SUMADEVALOR_LIQUIDA

COMMIT 


-- Recaudo de cartera  morosa de meses anteriores (4016-0200) incluye cobro coactivo
--BK SET FCR.Procesado = 1, FCR.ID_Tipo = 4, FCR.VALOR_MULTA_ACTUAL = RCM.SUMADEVALOR_LIQUIDA, FCR.ESTADO_COMPARENDO = 3
BEGIN TRANSACTION

---recaudo meses actual
UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 64, 
FCR.VALOR_MULTA_ACTUAL = FCR.VALOR_MULTA, 
FCR.ESTADO_COMPARENDO = 3
FROM [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RCM
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON RCM.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN STA_STTM..STA_Fact_Cartera_Generada_Mes FCGM ON FCGM.CONSECUTIVO_MOROSO = RCM.CONSECUTIVO_MOROSO
WHERE Procesado = 0 

COMMIT 


BEGIN TRANSACTION


---recaudo meses anteriores
UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 4, FCR.VALOR_MULTA_ACTUAL = FCR.VALOR_MULTA, FCR.ESTADO_COMPARENDO = 3
FROM [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RCM
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON RCM.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_MOROSOS_ESTADOS ES ON ES.CONSECUTIVO_MOROSO = RCM.CONSECUTIVO_MOROSO
WHERE Procesado = 0 
	--AND ES.ESTADO_MOROSO = 3

COMMIT 

-- Valor moroso disminuido por beneficio

BEGIN TRANSACTION

INSERT INTO [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS]
           ([CONSECUTIVO_MOROSO]
           ,[ID_USUARIO_MOROSO]
           ,[NRO_COMPARENDO_MOROSO]
           ,[TIPO_COMPARENDO]
           ,[FECHA_COMPARENDO]
           ,[NUMERO_RES]
           ,[FECHA_RESOLUCION]
           ,[TIPO_SANCION_MOROSO]
           ,[VALOR_MULTA]
           ,[ESTADO_COMPARENDO]
           ,[NUMERO_PLACA]
           ,[DESC_CLASE]
           ,[DESC_SERVICIO]
           ,[COBRO_COACTIVO]
           ,[FECHA_COBRO_COACTIVO]
           ,[ID_PERSONA]
           ,[PROCESADO]
           ,[ID_TIPO]
           ,[ID_TIPO_AJUSTE_MENOR]
           ,[DESCRIPCION_COMPARENDO]
           ,[NOMBRES]
           ,[APELLIDOS]
           ,[DIRECCION]
           ,[DESC_INFRACCION]
           ,[TELEFONO]
           ,[VALOR_MULTA_ACTUAL]
           ,[VALOR_AJUSTE_VALOR])

SELECT CVR.[CONSECUTIVO_MOROSO]
      ,CVR.[ID_USUARIO_MOROSO]
      ,CVR.[NRO_COMPARENDO_MOROSO]
      ,CVR.[TIPO_COMPARENDO]
      ,CVR.[FECHA_COMPARENDO]
      ,CVR.[NUMERO_RES]
      ,CVR.[FECHA_RESOLUCION]
      ,CVR.[TIPO_SANCION_MOROSO]
      ,CVR.[VALOR_MULTA]
      ,CVR.[ESTADO_COMPARENDO]
      ,CVR.[NUMERO_PLACA]
      ,CVR.[DESC_CLASE]
      ,CVR.[DESC_SERVICIO]
      ,CVR.[COBRO_COACTIVO]
      ,CVR.[FECHA_COBRO_COACTIVO]
      ,CVR.[ID_PERSONA]
      ,CVR.[PROCESADO]
      ,54 as [ID_TIPO]
      ,CVR.[ID_TIPO_AJUSTE_MENOR]
      ,CVR.[DESCRIPCION_COMPARENDO]
      ,CVR.[NOMBRES]
      ,CVR.[APELLIDOS]
      ,CVR.[DIRECCION]
      ,CVR.[DESC_INFRACCION]
      ,CVR.[TELEFONO]
      ,CMB.[SUMADEVALOR_BENEFICIO] as [VALOR_MULTA_ACTUAL]
      ,CVR.[VALOR_AJUSTE_VALOR]
  FROM [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS] CVR
  INNER JOIN [STA_STTM].[dbo].[STA_BENEFICIO_CARTERA_MOROSA] CMB ON CMB.[CONSECUTIVO_MOROSO] = CVR.[CONSECUTIVO_MOROSO]
  WHERE CVR.[PROCESADO] = 1 and CVR.[ID_TIPO] = 4

COMMIT 


BEGIN TRANSACTION


INSERT INTO [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS]
           ([CONSECUTIVO_MOROSO]
           ,[ID_TIPO] 
           ,[VALOR_MULTA_ACTUAL]
           ,[VALOR_MULTA])

SELECT CMB.[CONSECUTIVO_MOROSO]
,54 as [ID_TIPO]
,CMB.[SUMADEVALOR_BENEFICIO] as [VALOR_MULTA_ACTUAL]
,CMB.[SUMADEVALOR_BENEFICIO] as [VALOR_MULTA]
FROM [STA_STTM].[dbo].[STA_BENEFICIO_CARTERA_MOROSA] CMB  
LEFT JOIN [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS] CVR ON CMB.[CONSECUTIVO_MOROSO] = CVR.[CONSECUTIVO_MOROSO]
WHERE CVR.[CONSECUTIVO_MOROSO] IS NULL   


COMMIT 

-- Valor actualizado pagado por beneficio

BEGIN TRANSACTION

UPDATE CVR 
   SET CVR.[VALOR_MULTA_ACTUAL] = RCM.[SUMADEVALOR_PAGADO]
FROM [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS] CVR 
INNER JOIN [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RCM ON RCM.[CONSECUTIVO_MOROSO] = CVR.[CONSECUTIVO_MOROSO]
INNER JOIN [STA_STTM].[dbo].[STA_BENEFICIO_CARTERA_MOROSA] CMB ON CMB.[CONSECUTIVO_MOROSO] = CVR.[CONSECUTIVO_MOROSO]
WHERE [PROCESADO] = 1 and [ID_TIPO] = 4

COMMIT 

--Morosos meses anteriores, que celebran acuerdos de pago mes actual
BEGIN TRANSACTION

UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 5, FCR.VALOR_MULTA_ACTUAL = APM.VALOR_MULTA, FCR.ESTADO_COMPARENDO = 13 
FROM [STA_STTM].[dbo].[STA_MOROSOS_ACUERDO_PAGO_MES] APM
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON APM.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_MOROSOS_ESTADOS ES ON ES.CONSECUTIVO_MOROSO = APM.CONSECUTIVO_MOROSO
WHERE Procesado = 0  
	--AND ES.ESTADO_MOROSO = 13

COMMIT


--Pagos a través del SIMIT de cartera morosa  (externo - AV-VILLAS) MESES ANTERIORES
--SET FCR.Procesado = 1, FCR.ID_Tipo = 6 , FCR.VALOR_MULTA_ACTUAL = PS.VALOR_LIQUIDA, FCR.ESTADO_COMPARENDO = 3

BEGIN TRANSACTION

UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 6 , FCR.VALOR_MULTA_ACTUAL = PS.VALOR_LIQUIDA, FCR.ESTADO_COMPARENDO = 3
FROM [STA_STTM].[dbo].STA_PAGOS_SIMIT PS
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON PS.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_MOROSOS_ESTADOS ES ON ES.CONSECUTIVO_MOROSO = PS.CONSECUTIVO_MOROSO
WHERE Procesado = 0
	--AND ES.ESTADO_MOROSO = 3

COMMIT 


--Pagos a través del SIMIT de cartera morosa  (externo - AV-VILLAS) MES ACTUAL
BEGIN TRANSACTION

UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 66 , FCR.VALOR_MULTA_ACTUAL = PS.VALOR_LIQUIDA, FCR.ESTADO_COMPARENDO = 3
FROM [STA_STTM].[dbo].STA_PAGOS_SIMIT PS
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON PS.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN STA_STTM..STA_Fact_Cartera_Generada_Mes FCGM ON FCGM.CONSECUTIVO_MOROSO = PS.CONSECUTIVO_MOROSO
WHERE Procesado = 0

COMMIT 


--Actos administrativos y fallo judicial que revocan multas impuestas, ya causadas
BEGIN TRANSACTION

UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 7 , FCR.VALOR_MULTA_ACTUAL = FCR.VALOR_MULTA, FCR.ESTADO_COMPARENDO = 25 
FROM [STA_STTM].[dbo].STA_ACTOS_ADMINISTRATIVOS_MULTAS AD
LEFT JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON AD.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_MOROSOS_ESTADOS ES ON ES.CONSECUTIVO_MOROSO = AD.CONSECUTIVO_MOROSO
WHERE Procesado = 0
	--AND ES.ESTADO_MOROSO = 25

COMMIT 


--Prescripciones de cartera  otorgadas en el mes
BEGIN TRANSACTION

UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 8 , FCR.VALOR_MULTA_ACTUAL = FCR.VALOR_MULTA, FCR.ESTADO_COMPARENDO = 6
FROM [STA_STTM].[dbo].STA_PRESCRIPCIONES_CARTERA PC
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON PC.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_MOROSOS_ESTADOS ES ON ES.CONSECUTIVO_MOROSO = PC.CONSECUTIVO_MOROSO
WHERE Procesado = 0
	--AND ES.ESTADO_MOROSO = 6

COMMIT 




--Devoluciones morosas generadas de morosos meses anteriores
BEGIN TRANSACTION

UPDATE FCR
SET FCR.Procesado = 1, FCR.ID_Tipo = 11 , FCR.VALOR_MULTA_ACTUAL = FCR.VALOR_MULTA, FCR.ESTADO_COMPARENDO = 15
--select * 
FROM [STA_STTM].[dbo].STA_DEVOLUCIONES_MOROSAS DM
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_VALORES_RESTAS FCR ON DM.CONSECUTIVO_MOROSO = FCR.CONSECUTIVO_MOROSO
INNER JOIN [STA_STTM].[dbo].STA_FACT_CARTERA_MOROSOS_ESTADOS ES ON ES.CONSECUTIVO_MOROSO = DM.CONSECUTIVO_MOROSO
WHERE Procesado = 0
	--AND ES.ESTADO_MOROSO = 15

COMMIT 



 ---- recaudo aplicado mes anterior 
BEGIN TRANSACTION

  INSERT INTO [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS]
           ([CONSECUTIVO_MOROSO]
           ,[VALOR_MULTA]
           ,[PROCESADO]
           ,[ID_TIPO]
           ,[ID_TIPO_AJUSTE_MENOR])


SELECT RCM.CONSECUTIVO_MOROSO
      ,RCM.[SUMADEVALOR_PAGADO] AS Valor_Multa
	  , 1 AS Procesadoa
	  , 64 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
FROM [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RCM
LEFT JOIN STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR ON RCM.CONSECUTIVO_MOROSO = VR.CONSECUTIVO_MOROSO
where  VR.CONSECUTIVO_MOROSO is null
UNION ALL
SELECT PS.CONSECUTIVO_MOROSO
      ,PS.[VALOR_LIQUIDA] AS Valor_Multa
	  , 1 AS Procesadoa
	  , 66 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
FROM [STA_STTM].[dbo].STA_PAGOS_SIMIT PS 
LEFT JOIN STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR ON PS.CONSECUTIVO_MOROSO = VR.CONSECUTIVO_MOROSO
where  VR.CONSECUTIVO_MOROSO is null

COMMIT 


BEGIN TRANSACTION


INSERT INTO [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS]
           ([CONSECUTIVO_MOROSO]
           ,[VALOR_MULTA]
           ,[PROCESADO]
           ,[ID_TIPO]
           ,[ID_TIPO_AJUSTE_MENOR])
SELECT RCM.CONSECUTIVO_MOROSO
      ,RCM.[VALOR_MULTA]
	  , 1 AS Procesadoa
	  , 65 AS [ID_TIPO]
      , 0 AS Id_Tipo_Ajuste_Menor
FROM [STA_STTM].[dbo].[STA_FACT_CARTERA_VALORES_RESTAS] RCM
WHERE RCM.[ID_TIPO] = 61
COMMIT </sql>
