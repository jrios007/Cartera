  <step>
    <name>STA_FACT_CARTERA_VALORES_RESTAS </name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>STA_STTM</connection>
    <sql>select  
Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                      FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')
, VR.CONSECUTIVO_MOROSO
, MAX(ID_USUARIO_MOROSO) AS ID_USUARIO_MOROSO
, MAX(NRO_COMPARENDO_MOROSO) AS NRO_COMPARENDO_MOROSO
, MAX(TC.Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
, MAX(COALESCE(FECHA_COMPARENDO,'1900-01-01')) AS FECHA_COMPARENDO
, MAX(NUMERO_RES) AS NUMERO_RES
, MAX(F.Sk_Fecha) AS Sk_Fecha
, MAX(TSM.sk_Tipo_sancion_moroso) AS sk_Tipo_sancion_moroso
, MAX(VR.VALOR_MULTA_ACTUAL) AS VALOR_MULTA_ACTUAL
, MAX(EC.sk_Estado_Comparendo) AS sk_Estado_Comparendo
, MAX(COALESCE(NUMERO_PLACA, 'ND')) AS NUMERO_PLACA
, MAX(VR.DESC_CLASE) AS DESC_CLASE
, MAX(VR.DESC_SERVICIO) AS DESC_SERVICIO
, MAX(COALESCE(COBRO_COACTIVO, 'ND')) AS COBRO_COACTIVO
, MAX(COALESCE(FECHA_COBRO_COACTIVO,'1900-01-01')) AS FECHA_COBRO_COACTIVO
, MAX(P.sk_Persona) AS sk_Persona
, PROCESADO
, MAX(COALESCE(ID_TIPO,-1)) AS ID_TIPO
, MAX(ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
, MAX(COALESCE(DESCRIPCION_COMPARENDO,'ND')) AS DESCRIPCION_COMPARENDO
, MAX(COALESCE(NOMBRES,'ND')) AS NOMBRES
, MAX(COALESCE(APELLIDOS,'ND')) AS APELLIDOS
, MAX(COALESCE(VR.DIRECCION,'ND')) AS DIRECCION
, MAX(COALESCE(DESC_INFRACCION,'ND')) AS DESC_INFRACCION
, MAX(COALESCE(VR.TELEFONO,-1)) AS TELEFONO
, MAX(COALESCE(V.sk_Vehiculo,-1)) AS sk_Vehiculo
FROM STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR
LEFT JOIN DWH_STTM..Dim_Vehiculo V ON V.PLACA = VR.NUMERO_PLACA
LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON VR.TIPO_SANCION_MOROSO = TSM.Id_Tipo_sancion_moroso
LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON VR.TIPO_COMPARENDO = TC.Id_Tipo_Comparendo
LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON VR.ESTADO_COMPARENDO = EC.Codigo_Estado_Comparendo
LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON VR.ID_USUARIO_MOROSO = P.Identificacion
LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CONVERT(VARCHAR(8),VR.[FECHA_RESOLUCION],112)= F.Sk_Fecha
WHERE VR.ID_TIPO IN(4,5,6,7,8,10,11,42)
	--AND VR.Id_Tipo_Ajuste_Menor NOT IN (2)
GROUP BY VR.CONSECUTIVO_MOROSO,PROCESADO

UNION

select  
Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                      FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')
, VR.CONSECUTIVO_MOROSO
, MAX(ID_USUARIO_MOROSO) AS ID_USUARIO_MOROSO
, MAX(NRO_COMPARENDO_MOROSO) AS NRO_COMPARENDO_MOROSO
, MAX(TC.Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
, MAX(COALESCE(FECHA_COMPARENDO,'1900-01-01')) AS FECHA_COMPARENDO
, MAX(NUMERO_RES) AS NUMERO_RES
, MAX(F.Sk_Fecha) AS Sk_Fecha
, MAX(TSM.sk_Tipo_sancion_moroso) AS sk_Tipo_sancion_moroso
, MAX(VR.VALOR_MULTA_ACTUAL) AS VALOR_MULTA_ACTUAL
, MAX(EC.sk_Estado_Comparendo) AS sk_Estado_Comparendo
, MAX(COALESCE(NUMERO_PLACA, 'ND')) AS NUMERO_PLACA
, MAX(VR.DESC_CLASE) AS DESC_CLASE
, MAX(VR.DESC_SERVICIO) AS DESC_SERVICIO
, MAX(COALESCE(COBRO_COACTIVO, 'ND')) AS COBRO_COACTIVO
, MAX(COALESCE(FECHA_COBRO_COACTIVO,'1900-01-01')) AS FECHA_COBRO_COACTIVO
, MAX(P.sk_Persona) AS sk_Persona
, PROCESADO
, MAX(COALESCE(ID_TIPO,-1)) AS ID_TIPO
, MAX(ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
, MAX(COALESCE(DESCRIPCION_COMPARENDO,'ND')) AS DESCRIPCION_COMPARENDO
, MAX(COALESCE(NOMBRES,'ND')) AS NOMBRES
, MAX(COALESCE(APELLIDOS,'ND')) AS APELLIDOS
, MAX(COALESCE(VR.DIRECCION,'ND')) AS DIRECCION
, MAX(COALESCE(DESC_INFRACCION,'ND')) AS DESC_INFRACCION
, MAX(COALESCE(VR.TELEFONO,-1)) AS TELEFONO
, MAX(COALESCE(V.sk_Vehiculo,-1)) AS sk_Vehiculo
FROM STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR
LEFT JOIN DWH_STTM..Dim_Vehiculo V ON V.PLACA = VR.NUMERO_PLACA
LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON VR.TIPO_SANCION_MOROSO = TSM.Id_Tipo_sancion_moroso
LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON VR.TIPO_COMPARENDO = TC.Id_Tipo_Comparendo
LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON VR.ESTADO_COMPARENDO = EC.Codigo_Estado_Comparendo
LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON VR.ID_USUARIO_MOROSO = P.Identificacion
LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CONVERT(VARCHAR(8),VR.[FECHA_RESOLUCION],112)= F.Sk_Fecha
WHERE VR.ID_TIPO IN(54,61,63,64,66)
	--AND VR.Id_Tipo_Ajuste_Menor NOT IN (2)
GROUP BY VR.CONSECUTIVO_MOROSO,PROCESADO

UNION

--SEPARANDO EL 65 PARA SUBIRLO EN LA 4

select  
Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                      FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')
, VR.CONSECUTIVO_MOROSO
, MAX(ID_USUARIO_MOROSO) AS ID_USUARIO_MOROSO
, MAX(NRO_COMPARENDO_MOROSO) AS NRO_COMPARENDO_MOROSO
, MAX(TC.Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
, MAX(COALESCE(FECHA_COMPARENDO,'1900-01-01')) AS FECHA_COMPARENDO
, MAX(NUMERO_RES) AS NUMERO_RES
, MAX(F.Sk_Fecha) AS Sk_Fecha
, MAX(TSM.sk_Tipo_sancion_moroso) AS sk_Tipo_sancion_moroso
, MAX(VR.VALOR_MULTA_ACTUAL) AS VALOR_MULTA_ACTUAL
, MAX(EC.sk_Estado_Comparendo) AS sk_Estado_Comparendo
, MAX(COALESCE(NUMERO_PLACA, 'ND')) AS NUMERO_PLACA
, MAX(VR.DESC_CLASE) AS DESC_CLASE
, MAX(VR.DESC_SERVICIO) AS DESC_SERVICIO
, MAX(COALESCE(COBRO_COACTIVO, 'ND')) AS COBRO_COACTIVO
, MAX(COALESCE(FECHA_COBRO_COACTIVO,'1900-01-01')) AS FECHA_COBRO_COACTIVO
, MAX(P.sk_Persona) AS sk_Persona
, PROCESADO
, MAX(COALESCE(4,-1)) AS ID_TIPO
, MAX(ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
, MAX(COALESCE(DESCRIPCION_COMPARENDO,'ND')) AS DESCRIPCION_COMPARENDO
, MAX(COALESCE(NOMBRES,'ND')) AS NOMBRES
, MAX(COALESCE(APELLIDOS,'ND')) AS APELLIDOS
, MAX(COALESCE(VR.DIRECCION,'ND')) AS DIRECCION
, MAX(COALESCE(DESC_INFRACCION,'ND')) AS DESC_INFRACCION
, MAX(COALESCE(VR.TELEFONO,-1)) AS TELEFONO
, MAX(COALESCE(V.sk_Vehiculo,-1)) AS sk_Vehiculo
FROM STA_STTM..STA_FACT_CARTERA_VALORES_RESTAS VR
LEFT JOIN DWH_STTM..Dim_Vehiculo V ON V.PLACA = VR.NUMERO_PLACA
LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON VR.TIPO_SANCION_MOROSO = TSM.Id_Tipo_sancion_moroso
LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON VR.TIPO_COMPARENDO = TC.Id_Tipo_Comparendo
LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON VR.ESTADO_COMPARENDO = EC.Codigo_Estado_Comparendo
LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON VR.ID_USUARIO_MOROSO = P.Identificacion
LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CONVERT(VARCHAR(8),VR.[FECHA_RESOLUCION],112)= F.Sk_Fecha
WHERE VR.ID_TIPO IN(65)
	--AND VR.Id_Tipo_Ajuste_Menor NOT IN (2)
GROUP BY VR.CONSECUTIVO_MOROSO,PROCESADO



</sql>
