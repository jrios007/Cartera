  <step>
    <name>Recuperacion_Saneamiento</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>STA_STTM</connection>
    <sql> select  
  sta.[CONSECUTIVO_MOROSO]
      ,sta.[ID_USUARIO_MOROSO]
      ,sta.[NRO_COMPARENDO_MOROSO]
      ,sta.[TIPO_COMPARENDO]
      ,sta.[FECHA_COMPARENDO]
      ,sta.[NUMERO_RES]
      ,sta.[FECHA_RESOLUCION]
      ,sta.[TIPO_SANCION_MOROSO]
      ,sta.[VALOR_MULTA]
      ,sta.[ESTADO_MOROSO]
      ,sta.[DESCRIPCION_ESTADO]
      ,sta.[NUMERO_PLACA]
      ,sta.[DESC_CLASE]
      ,sta.[DESC_SERVI]
      ,sta.[COBRO_COACTIVO]
      ,sta.[FECHA_COBRO_COACTIVO]
      ,sta.[DESCRIPCION_COMPARENDO]
      ,sta.[NOMBRES]
      ,sta.[APELLIDOS]
      ,sta.[DIRECCION]
      ,sta.[DESC_INFRACCION]
      ,sta.[TELEFONO]
      ,sta.[VALOR_INTERESES_MOROSOS]
      ,sta.[PROCESAR_INTERES]
      ,sta.[FECHA_CUOTA]
  FROM STA_STTM..STA_Fact_Cartera_Moroso sta
  INNER JOIN (
			  SELECT
				  CONSECUTIVO_MOROSOS AS CONSECUTIVO_MOROSOS
				FROM STA_STTM..TMP_Prescritos_suministrado_x_interventoria
			UNION ALL
				SELECT
				  CONSECUTIVO_MOROSOS AS CONSECUTIVO_MOROSOS
				FROM STA_STTM..TMP_Base_saneamiento
			 ) AUX
				ON sta.CONSECUTIVO_MOROSO = AUX.CONSECUTIVO_MOROSOS</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>290</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

