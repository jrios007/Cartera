  <step>
    <name>MANDAMIENTOS_EXTRA</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>QITS</connection>
    <sql>  SELECT DISTINCT cpl.id_cartera_externa   consecutivo_moroso,
  mc.valor_identificador_deuda,
  mp.fecha_mandamiento,
  mp.NUMERO_MANDAMIENTO
  FROM cobro_medellin.maestro_cartera mc
  INNER JOIN cobro_medellin.cartera_mandamiento cm ON mc.id_cartera = cm.id_cartera
  AND cm.activo = 'S'
  INNER JOIN cobro_medellin.mandamiento_pago mp ON mp.id_mandamiento = cm.id_mandamiento
  AND mp.fecha_notificacion IS NOT NULL
  INNER JOIN cobro_medellin.cartera_plataforma cpl ON mc.id_cartera = cpl.id_cartera
  INNER JOIN cobro_medellin.estado_mandamiento em ON mp.id_mandamiento = em.id_mandamiento
  AND em.id_estado = 12
  WHERE NOT EXISTS (
  SELECT 1
  FROM cobro_medellin.estado_mandamiento em2
  WHERE em.id_mandamiento = em2.id_mandamiento
  AND em2.id_estado = 5
  )



            
			
          </sql>
