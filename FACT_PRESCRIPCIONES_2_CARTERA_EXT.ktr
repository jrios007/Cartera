  <step>
    <name>COMP_RESOLUCION_PROCESO</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>qxtransito</connection>
    <sql>SELECT 
MOROSOS.ID_USUARIO_MOROSO, 
MOROSOS.NUMERO_RES, 
COMP_RESOLUCION_PROCESO.CONSECUTIVO_MOROSOS, 
COMP_RESOLUCION_PROCESO.ID_TIPO_RESOLUCION, 
COMP_TIPO_RESOLUCION.DESCRIPCION, 
MOROSOS.NRO_COMPARENDO_MOROSO, 
MAX(COMP_RESOLUCION_PROCESO.NRO_RESOLUCION) AS NRO_RESOLUCION, 
MOROSOS.ESTADO_MOROSO, 
COMP_RESOLUCION_PROCESO.ID_ESTADO, 
MOROSOS.TIPO_SANCION, 
MOROSOS.VALOR_MULTA, 
Max(COMP_RESOLUCION_PROCESO.FECHA_GENERA) AS MáxDeFECHA_GENERA, 
COMP_RESOLUCION_PROCESO.JUSTIFICACION
FROM COMP_RESOLUCION_PROCESO 
INNER JOIN MOROSOS ON COMP_RESOLUCION_PROCESO.CONSECUTIVO_MOROSOS = MOROSOS.CONSECUTIVO_MOROSOS
INNER JOIN COMP_TIPO_RESOLUCION ON COMP_RESOLUCION_PROCESO.ID_TIPO_RESOLUCION = COMP_TIPO_RESOLUCION.ID_TIPO
GROUP BY MOROSOS.ID_USUARIO_MOROSO, MOROSOS.NUMERO_RES, COMP_RESOLUCION_PROCESO.CONSECUTIVO_MOROSOS, 
COMP_RESOLUCION_PROCESO.ID_TIPO_RESOLUCION, COMP_TIPO_RESOLUCION.DESCRIPCION, MOROSOS.NRO_COMPARENDO_MOROSO, 
MOROSOS.ESTADO_MOROSO, COMP_RESOLUCION_PROCESO.ID_ESTADO, MOROSOS.TIPO_SANCION, MOROSOS.VALOR_MULTA, 
COMP_RESOLUCION_PROCESO.JUSTIFICACION, MOROSOS.FECHA_GENERACION
HAVING 
(((COMP_RESOLUCION_PROCESO.ID_TIPO_RESOLUCION) In ('13')) AND ((MOROSOS.ESTADO_MOROSO)='6') AND ((COMP_RESOLUCION_PROCESO.ID_ESTADO)='1') 
AND ((Max(COMP_RESOLUCION_PROCESO.FECHA_GENERA)) Between TO_DATE(?,'YYYYMMDD HH24:MI:SS') AND TO_DATE(?,'YYYYMMDD HH24:MI:SS'))  
AND ((MOROSOS.FECHA_GENERACION) Between TO_DATE(?,'YYYYMMDD HH24:MI:SS') AND TO_DATE(?,'YYYYMMDD HH24:MI:SS') ))</sql>
    <limit>0</limit>
    <lookup>INFO_PARAMETROS</lookup>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>150</xloc>
      <yloc>550</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
