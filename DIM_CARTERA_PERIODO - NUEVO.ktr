  <step>
    <name>Cartera_Vigente_FOTO1</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>STA_STTM</connection>
    <sql>  SELECT  FCM.[Id_Mes_Corte]
      ,FCM.[Consecutivo_Moroso]
      ,FCM.[ID_Usuario_Moroso]
	  ,dtd.Desc_Tipo_Documento
      ,FCM.[Nro_Comparendo_Moroso]
      ,FCM.[Sk_Tipo_Comparendo]
      ,format(FCM.[Fecha_Comparendo],'dd/MM/yyyy') as Fecha_Comparendo
      ,FCM.[Numero_Res]
      ,FCM.[Sk_Fecha]
      ,FCM.[sk_Tipo_sancion_moroso]
      ,FCM.[Valor_Multa]
      ,FCM.[sk_Estado_Comparendo]
      ,RTRIM(FCM.[Numero_Placa]) AS Numero_Placa
      ,RTRIM(FCM.[Desc_Clase]) AS Desc_Clase
      ,RTRIM(FCM.[Desc_Servi]) AS Desc_Servi
      ,FCM.[Cobro_Coactivo]
      ,format(FCM.[Fecha_Cobro_Coactivo],'dd/MM/yyyy') Fecha_Cobro_Coactivo
   --   ,[sk_Persona]
   --   ,[Sk_Tipo]
   --   ,[Id_Tipo_Ajuste_Menor]
      ,REPLACE(RTRIM(FCM.[Descripcion_Comparendo]),',','') AS Descripcion_Comparendo 
      ,RTRIM(FCM.[Nombres]) AS Nombres 
      ,RTRIM(FCM.[Apellidos]) AS Apellidos
      ,RTRIM(FCM.[Telefono]) AS Telefono
      ,RTRIM(FCM.[Direccion]) AS Direccion
      ,RTRIM(FCM.[Desc_Infraccion]) AS Desc_Infraccion 
   --   ,[sk_Vehiculo]
      ,FCM.[Valor_Intereses_Morosos]
      ,CV.[Procesar_Interes]
      ,FCM.[Sk_Fecha_Cuota]
      , CV.ESTADO_MOROSO
      , CV.DESCRIPCION_ESTADO
	  , mp.NRO_MANDAMIENTO
	  ,format(mp.fecha_mandamiento,'dd/MM/yyyy') fecha_mandamiento
FROM [DWH_STTM].[dbo].[Fact_Cartera_Moroso] FCM
LEFT JOIN [STA_STTM].[dbo].[STA_Fact_Cartera_Moroso] CV on FCM.Consecutivo_Moroso = Cv.CONSECUTIVO_MOROSO 
LEFT JOIN [DWH_STTM].[dbo].[Dim_Persona] dp ON FCM.ID_Usuario_Moroso = [dp].Identificacion
LEFT JOIN [DWH_STTM].[dbo].[Dim_Tipo_Documento] dtd ON dtd.Id_Tipo_documento = dp.Sk_Tipo_documento
left join [DWH_STTM].[dbo].[MANDAMIENTOS_PAGO] mp on mp.consecutivo_moroso = FCM.Consecutivo_Moroso

WHERE FCM.[Id_Mes_Corte] = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')   and 	fcm.Nro_Comparendo_Moroso like 'D%'

and FCM.[Sk_Fecha] &lt;= 20230601

/*AND  (
(FCM.[Nombres] LIKE '%CHAR(10)%' OR  FCM.[Nombres] LIKE '% CHAR(13)%') OR
(FCM.[Apellidos] LIKE '%CHAR(10)%' OR  FCM.[Apellidos] LIKE '%CHAR(13)%') OR
(FCM.[Telefono] LIKE '%CHAR(10)%' OR  FCM.[Telefono] LIKE '%CHAR(13)%') OR
(FCM.[Direccion] LIKE '%CHAR(10)%' OR  FCM.[Direccion] LIKE '%CHAR(13)%') OR
(FCM.[Descripcion_Comparendo] LIKE '%CHAR(10)%' OR  FCM.[Descripcion_Comparendo] LIKE '%CHAR(13)%')
OR CHARINDEX(FCM.[Nombres], CHAR(10),1)>0
OR CHARINDEX(FCM.[Apellidos], CHAR(10),1)>0
OR CHARINDEX(FCM.[Telefono], CHAR(10),1)>0
OR CHARINDEX(FCM.[Direccion], CHAR(10),1)>0
OR CHARINDEX(FCM.[Nombres], CHAR(13),1)>0
OR CHARINDEX(FCM.[Apellidos], CHAR(13),1)>0
OR CHARINDEX(FCM.[Telefono], CHAR(13),1)>0
OR CHARINDEX(FCM.[Direccion], CHAR(13),1)>0
OR CHARINDEX(FCM.[Descripcion_Comparendo], CHAR(10),1)>0
OR CHARINDEX(FCM.[Descripcion_Comparendo], CHAR(13),1)>0
)*/
AND FCM.Sk_Tipo in (1,12)

</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
