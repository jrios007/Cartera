  <step>
    <name>STA_Fact_Cartera_Moroso</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DWH_STTM</connection>
    <sql>/*Pone en estado procesado 0 y sk_tipo 0 a lo que sigue moroso y viene de meses anteriores*/

SELECT 
	   CM.CONSECUTIVO_MOROSO
      ,MAX(CM.ID_Usuario_Moroso) AS ID_Usuario_Moroso
      ,MAX(CM.Nro_Comparendo_Moroso) AS Nro_Comparendo_Moroso
      ,MAX(TC.Id_Tipo_Comparendo) AS Id_Tipo_Comparendo
      ,MAX(CM.Fecha_Comparendo) AS Fecha_Comparendo
      ,MAX(CM.Numero_Res) AS Numero_Res
	  --,SCM.Fecha_Resolucion
      ,MAX(CONVERT(VARCHAR(8),F.Fecha,112)) AS Fecha_Resolucion
      ,MAX(TSM.Id_Tipo_sancion_moroso) AS Id_Tipo_sancion_moroso
      ,MAX(CM.Valor_Multa) AS Valor_Multa
      ,MAX(EC.Codigo_Estado_Comparendo) AS Codigo_Estado_Comparendo
      ,MAX(CM.Numero_Placa) AS Numero_Placa
      ,MAX(CM.Desc_Clase) AS Desc_Clase
      ,MAX(CM.DESC_SERVI)  AS DESC_SERVI
      ,MAX(CM.Cobro_Coactivo) AS Cobro_Coactivo
      ,MAX(CM.Fecha_Cobro_Coactivo) AS Fecha_Cobro_Coactivo
      ,MAX( P.Identificacion) AS  Identificacion
	  , 0 AS Procesado
	  , 0 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
      ,MAX(COALESCE(SCM.DESCRIPCION_COMPARENDO,'ND')) AS DESCRIPCION_COMPARENDO 
      ,MAX(COALESCE(SCM.NOMBRES,'ND')) AS NOMBRES
      ,MAX(COALESCE(SCM.APELLIDOS,'ND')) AS APELLIDOS 
      ,MAX(COALESCE(SCM.DIRECCION,'ND')) AS DIRECCION
      ,MAX(COALESCE(SCM.DESC_INFRACCION,'ND')) AS DESC_INFRACCION
	  ,MAX(COALESCE(SCM.TELEFONO,-1)) AS TELEFONO
  FROM ( SELECT DISTINCT Consecutivo_Moroso, ID_Usuario_Moroso, Nro_Comparendo_Moroso, 
			Fecha_Comparendo, Numero_Res, ID_MES_CORTE, Valor_Multa, Numero_Placa, Desc_Clase
		   ,CM.DESC_SERVI, CM.Cobro_Coactivo, Fecha_Cobro_Coactivo, sk_fecha, Sk_Tipo_Comparendo
		   , sk_Tipo_sancion_moroso, sk_Estado_Comparendo, sk_Persona
			FROM DWH_STTM.dbo.Fact_Cartera_Moroso CM
			WHERE  CM.Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
					THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + '12' AS INTEGER)
					ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
					FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
			AND CM.Sk_Tipo IN (1,12)
		) CM
  LEFT JOIN STA_STTM.dbo.STA_Fact_Cartera_Moroso SCM  
	ON  SCM.Consecutivo_Moroso = CM.Consecutivo_Moroso	and SCM.VIGENTE = 'S'
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON CM.Sk_Tipo_Comparendo = TC.Sk_Tipo_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CM.Sk_Fecha = F.Sk_Fecha
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON CM.sk_Tipo_sancion_moroso = TSM.sk_Tipo_sancion_moroso
  LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON CM.sk_Estado_Comparendo = EC.sk_Estado_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON CM.sk_Persona = P.sk_Persona
  WHERE  SCM.CONSECUTIVO_MOROSO IS NULL
  GROUP BY CM.CONSECUTIVO_MOROSO


UNION ALL
---Reacudo aplicado en mes anterior
SELECT 
	   CM.CONSECUTIVO_MOROSO
      ,MAX(CM.ID_Usuario_Moroso) AS ID_Usuario_Moroso
      ,MAX(CM.Nro_Comparendo_Moroso) AS Nro_Comparendo_Moroso
      ,MAX(TC.Id_Tipo_Comparendo) AS Id_Tipo_Comparendo
      ,MAX(CM.Fecha_Comparendo) AS Fecha_Comparendo
      ,MAX(CM.Numero_Res) AS Numero_Res
	  --,SCM.Fecha_Resolucion
      ,MAX(CONVERT(VARCHAR(8),F.Fecha,112)) AS Fecha_Resolucion
      ,MAX(TSM.Id_Tipo_sancion_moroso) AS Id_Tipo_sancion_moroso
      ,MAX(CM.Valor_Multa) AS Valor_Multa
      ,MAX(EC.Codigo_Estado_Comparendo) AS Codigo_Estado_Comparendo
      ,MAX(CM.Numero_Placa) AS Numero_Placa
      ,MAX(CM.Desc_Clase) AS Desc_Clase
      ,MAX(CM.DESC_SERVI)  AS DESC_SERVI
      ,MAX(CM.Cobro_Coactivo) AS Cobro_Coactivo
      ,MAX(CM.Fecha_Cobro_Coactivo) AS Fecha_Cobro_Coactivo
      ,MAX( P.Identificacion) AS  Identificacion
	  , 0 AS Procesado
	  , 63 AS Sk_Tipo
      , 0 AS Id_Tipo_Ajuste_Menor
      ,MAX(COALESCE(CM.DESCRIPCION_COMPARENDO,'ND')) AS DESCRIPCION_COMPARENDO 
      ,MAX(COALESCE(CM.NOMBRES,'ND')) AS NOMBRES
      ,MAX(COALESCE(CM.APELLIDOS,'ND')) AS APELLIDOS 
      ,MAX(COALESCE(CM.DIRECCION,'ND')) AS DIRECCION
      ,MAX(COALESCE(CM.DESC_INFRACCION,'ND')) AS DESC_INFRACCION
	  ,MAX(COALESCE(CM.TELEFONO,-1)) AS TELEFONO
  FROM DWH_STTM.dbo.Fact_Cartera_Moroso CM 
  INNER JOIN STA_STTM..STA_RECAUDO_CARTERA_MOROSA SCM  
	ON  SCM.Consecutivo_Moroso = CM.Consecutivo_Moroso	
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON CM.Sk_Tipo_Comparendo = TC.Sk_Tipo_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CM.Sk_Fecha = F.Sk_Fecha
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON CM.sk_Tipo_sancion_moroso = TSM.sk_Tipo_sancion_moroso
  LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON CM.sk_Estado_Comparendo = EC.sk_Estado_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON CM.sk_Persona = P.sk_Persona
  WHERE CM.Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
					THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + '12' AS INTEGER)
					ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
					FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
			AND CM.Sk_Tipo IN (42)
			GROUP BY CM.CONSECUTIVO_MOROSO</sql>
    <limit>0</limit>
