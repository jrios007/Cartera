  <step>
    <name>SOLICITUD_DETALLE_CONTRAV</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>qxtransito</connection>
    <sql>SELECT /*+ PARALLEL(ES 4) PARALLEL(SI 4) PARALLEL(MOROSOS 4) */ 
	   ES.nro_tramite, 
       ES.nro_recibo, 
       ES.estado_recibo, 
       ES.fecha_liquida, 
       ES.identificador_solicitud, 
       ES.id_punto_atencion, 
       ES.id_estado_solicitud, 
       morosos.consecutivo_morosos,
       MOROSOS.FECHA_GENERACION,
       SUM(SI.VALOR_TARIFA)  AS SumaDeVALOR_PAGADO, 
       SUM(SI.VALOR_TARIFA) AS SumaDeVALOR_LIQUIDA 
FROM  SOLICITUD_MAESTRO ES 
inner join solicitud_ingreso SI ON SI.nro_tramite =    ES.nro_tramite
inner join tipo_tarifas tt on si.id_tarifa = tt.id_tarifa
inner join morosos ON SI.IDENTIFICADOR =  TO_CHAR(morosos.consecutivo_morosos)
WHERE --ES.NRO_TRAMITE = 28108770 AND 
        (ES.nro_recibo &lt;&gt; '0' AND  ES.estado_recibo  IN ('1', '2','3' ) )
         --AND ES.fecha_liquida BETWEEN  To_date('01/06/2020', 'dd/mm/yyyy') AND   To_date('30/06/2020', 'dd/mm/yyyy') 
         --AND ES.fecha_liquida BETWEEN  TO_DATE(TRIM(?),'YYYYMMDD HH24:MI:SS') AND TO_DATE(TRIM(?),'YYYYMMDD HH24:MI:SS') 
			AND ES.fecha_liquida BETWEEN  TO_DATE('20251201 00:00:00','YYYYMMDD HH24:MI:SS') AND TO_DATE('20251231 23:59:59','YYYYMMDD HH24:MI:SS') 
         and tt.TARIFA_INTERES = 'N'
         AND ( ES.id_punto_atencion  &lt;&gt; '98' )  
         AND (SI.VALOR_TARIFA > 0) 
         AND  ES.nro_tramite || morosos.consecutivo_morosos not in (
'2992363812263777','2994582512697373','2992363813055126','2994405713879930','2994405713900420','2994405714169234','3378150814078353', '3378163014564758', '3376129215913271',
'2994405716048225','2994175517060115','2994405719415591','2994071119416701','2993538719742193','336780129852860','336780179702739','3368554811023638','3368556011023638','3368556811023638','3368557811023638','3385171722132748','3390903710493935',
'340243048334056','340238659356620','340239239356620','340243089712080','340243189749000','3402390112661244','3401202521173109', '3406789510490979', '3406790011967908','3413463519367428','3418862019367428','3428508421486181','3428506321233397',
'3497699510767682','3495330318562492','3494154815347500','350132618103540','350554558438101','350840328027922','350299547561586','350425148103710','3501693716287661','350438138129525','350554558438101','3506229610280170',
'3503128011809536','3501693716287661','3502106919230053','351061768031733','351542938359198','351656108364992','351678628466143','3516944815534669','351694498432879','35266527285498','352207138120453','352703748154563','352195108300369',
'352394538466606','352357008852258','3521941110085978','3522515510304915','3526764911172194','3520773811830145','3520120113271423','3523086813389117','3524433415378282')

GROUP BY ES.nro_tramite, 
       ES.nro_recibo, 
       ES.estado_recibo, 
       ES.fecha_liquida, 
       ES.identificador_solicitud, 
       ES.id_punto_atencion, 
       ES.id_estado_solicitud, 
       MOROSOS.CONSECUTIVO_MOROSOS,
       MOROSOS.FECHA_GENERACION</sql>
