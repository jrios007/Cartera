  <step>
    <name>AJUSTES POR MENOR VALOR</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>STA_STTM</connection>
    <sql>SELECT 
		  MAX(CM.NRO_TRAMITE)AS NRO_TRAMITE
		, MAX(CM.NRO_RECIBO) AS NRO_RECIBO
		, MAX(CM.ESTADO_RECIBO)ESTADO_RECIBO
		, MAX(CM.FECHA_LIQUIDA)AS FECHA_LIQUIDA
		, MAX(CM.IDENTIFICADOR_SOLICITUD)AS IDENTIFICADOR_SOLICITUD
		, MAX(CM.ID_PUNTO_ATENCION)AS  ID_PUNTO_ATENCION
		, MAX(CM.ID_ESTADO_SOLICITUD)AS  ID_ESTADO_SOLICITUD
		, REC.CONSECUTIVO_MOROSO
		, MAX(CM.FECHA_GENERACION)AS  FECHA_GENERACION
		, MAX(CM.SUMADEVALOR_LIQUIDA) AS VALOR_LIQUIDA
		, MAX(RES.VALOR_MULTA)AS  VALOR_MULTA
		, MAX(ABS(RES.VALOR_MULTA_ACTUAL - REC.VALOR_MULTA)) AS VALOR_DIFERENCIA
		--, MAX(CASE WHEN REC.VALOR_MULTA &lt; RES.VALOR_MULTA THEN 9 ELSE 2 END) AS Id_Tipo_Ajuste_Menor
        ,MAX(CASE WHEN REC.VALOR_MULTA > RES.VALOR_MULTA_ACTUAL THEN 9 ELSE 2 END) AS Id_Tipo_Ajuste_Menor
FROM STA_FACT_CARTERA_VALORES_RESTAS RES
INNER JOIN DWH_STTM..Fact_Cartera_Moroso REC ON RES.CONSECUTIVO_MOROSO = REC.CONSECUTIVO_MOROSO
INNER JOIN STA_RECAUDO_CARTERA_MOROSA CM ON CM.CONSECUTIVO_MOROSO =RES.CONSECUTIVO_MOROSO
	AND REC.Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
                            THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + '12' AS INTEGER)
                            ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
                            FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')
LEFT JOIN [STA_STTM].[dbo].STA_BENEFICIO_CARTERA_MOROSA BPC ON RES.CONSECUTIVO_MOROSO = BPC.CONSECUTIVO_MOROSO
WHERE RES.VALOR_MULTA_ACTUAL &lt;&gt; REC.Valor_Multa AND BPC.CONSECUTIVO_MOROSO IS NULL
and REs.id_tipo IN (4,5,6)
GROUP BY REC.CONSECUTIVO_MOROSO




--FROM STA_FACT_CARTERA_VALORES_RESTAS RES
--INNER JOIN STA_RECAUDO_CARTERA_MOROSA REC
	--ON RES.CONSECUTIVO_MOROSO = REC.CONSECUTIVO_MOROSO
--WHERE RES.Valor_Multa &lt;&gt; REC.SUMADEVALOR_LIQUIDA</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
