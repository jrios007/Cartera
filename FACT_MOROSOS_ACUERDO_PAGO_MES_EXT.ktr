  <step>
    <name>Acuerdo de pago</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>qxtransito</connection>
    <sql>SELECT apm.NRO_ACUERDO, apm.SALDO_AP, apdcm.CONSECUTIVO_MOROSOS, mr.TIPO_SANCION, mr.FECHA_RESOLUCION,
mr.VALOR_MULTA, mr.ESTADO_MOROSO, mr.FECHA_GENERACION, apm.FECHA_AP
FROM AP_MAESTRO apm
INNER JOIN AP_DETALLE_COMP_MOROSO apdcm  ON apm.CONSECUTIVO_AP = apdcm.CONSECUTIVO_AP
INNER JOIN MOROSOS mr  ON apdcm.CONSECUTIVO_MOROSOS = mr.CONSECUTIVO_MOROSOS
WHERE apm.ID_ESTADO=1 and mr.ESTADO_MOROSO='13'
AND ((mr.FECHA_GENERACION)&lt;(to_date(?, 'yyyymmdd hh24:mi:ss') ) )
AND (apm.FECHA_AP) Between to_date(?, 'yyyymmdd hh24:mi:ss') and to_date(?, 'yyyymmdd hh24:mi:ss')
--(TRUNC(SYSDATE, 'MM')) And TO_DATE(TO_CHAR((TRUNC(SYSDATE)-1), 'dd/mm/yyyy') || ' 23:59:59', 'dd/mm/yyyy hh24:mi:ss')))
--ORDER BY MOROSOS.FECHA_GENERACION
GROUP BY apm.NRO_ACUERDO, apm.SALDO_AP, apdcm.CONSECUTIVO_MOROSOS,
mr.TIPO_SANCION, mr.FECHA_RESOLUCION, mr.VALOR_MULTA,
mr.ESTADO_MOROSO, mr.FECHA_GENERACION, apm.FECHA_AP

UNION

SELECT apm.NRO_ACUERDO, apm.SALDO_AP, apdcm.CONSECUTIVO_MOROSOS, mr.TIPO_SANCION, mr.FECHA_RESOLUCION,
mr.VALOR_MULTA, mr.ESTADO_MOROSO, mr.FECHA_GENERACION, apm.FECHA_AP
FROM AP_MAESTRO apm
INNER JOIN AP_DETALLE_COMP_MOROSO apdcm ON apm.CONSECUTIVO_AP = apdcm.CONSECUTIVO_AP
INNER JOIN MOROSOS mr ON apdcm.CONSECUTIVO_MOROSOS = mr.CONSECUTIVO_MOROSOS
WHERE apm.ID_ESTADO=2 and mr.ESTADO_MOROSO='3'
AND mr.FECHA_GENERACION&lt;(to_date(?, 'yyyymmdd hh24:mi:ss') )
AND (apm.FECHA_AP) Between to_date(?, 'yyyymmdd hh24:mi:ss') and to_date(?, 'yyyymmdd hh24:mi:ss')
--(TRUNC(SYSDATE, 'MM')) And TO_DATE(TO_CHAR((TRUNC(SYSDATE)-1), 'dd/mm/yyyy') || ' 23:59:59', 'dd/mm/yyyy hh24:mi:ss')))
--ORDER BY MOROSOS.FECHA_GENERACION
GROUP BY apm.NRO_ACUERDO, apm.SALDO_AP, apdcm.CONSECUTIVO_MOROSOS,
mr.TIPO_SANCION, mr.FECHA_RESOLUCION, mr.VALOR_MULTA,
mr.ESTADO_MOROSO, mr.FECHA_GENERACION, apm.FECHA_AP</sql>
    <limit>0</limit>
    <lookup>INFO_PARAMETROS</lookup>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
