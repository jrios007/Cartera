    <connection>DWH_STTM</connection>
    <sql>SELECT
CONVERT(nvarchar(8),fecha_inicio,112) + ' ' + '00:00:00' AS fecha_inicial,
CONVERT(nvarchar(8),fecha_inicio,112) + ' ' + '00:00:00' AS fecha_inicial_1,
CONVERT(nvarchar(8),fecha_fin,112) + ' ' + '23:59:59' AS fecha_final,
CONVERT(nvarchar(8),fecha_inicio,112) + ' ' + '00:00:00' AS fecha_inicial1,
CONVERT(nvarchar(8),fecha_inicio,112) + ' ' + '00:00:00' AS fecha_inicial1_1,
CONVERT(nvarchar(8),fecha_fin,112) + ' ' + '23:59:59' AS fecha_final1
FROM DIM_PARAMETROS
WHERE ID_PARAM='Cartera_Contravenciones'</sql>
