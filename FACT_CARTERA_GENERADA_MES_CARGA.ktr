    <quoteString>N</quoteString>
    <sql>BEGIN TRANSACTION


																							
INSERT INTO [DWH_STTM].[dbo].[Fact_Cartera_Moroso]
           ([Id_Mes_Corte]
           ,[Consecutivo_Moroso]
           ,[ID_Usuario_Moroso]
           ,[Nro_Comparendo_Moroso]
           ,[Sk_Tipo_Comparendo]
           ,[Fecha_Comparendo]
           ,[Numero_Res]
           ,[Sk_Fecha]
           ,[sk_Tipo_sancion_moroso]
           ,[Valor_Multa]
           ,[sk_Estado_Comparendo]
           ,[Numero_Placa]
           ,[Desc_Clase]
           ,[Desc_Servi]
           ,[Cobro_Coactivo]
           ,[Fecha_Cobro_Coactivo]
           ,[sk_Persona]
           ,[Sk_Tipo]
           ,[Id_Tipo_Ajuste_Menor]
           ,[Descripcion_Comparendo]
           ,[Nombres]
           ,[Apellidos]
           ,[Direccion]
           ,[Desc_Infraccion]
           ,[Telefono]
            ,[sk_Vehiculo]
           ,[Sk_Fecha_Cuota]
           ,[Valor_Intereses_Morosos]
        )
    SELECT 
       MAX(CGM.ID_MES_CORTE) AS ID_MES_CORTE
      ,CONSECUTIVO_MOROSO
      ,MAX(ID_USUARIO_MOROSO) AS ID_USUARIO_MOROSO
      ,MAX(NRO_COMPARENDO_MOROSO) AS NRO_COMPARENDO_MOROSO
      ,MAX(Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
      ,MAX(CAST([FECHA_COMPARENDO] AS DATE))FECHA_COMPARENDO
      ,MAX(NUMERO_RES) AS NUMERO_RES
      ,MAX(CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112))AS Sk_Fecha
      ,MAX(TSM.sk_Tipo_sancion_moroso) AS sk_Tipo_sancion_moroso
      ,MAX(VALOR_MULTA) AS VALOR_MULTA
      ,MAX(EC.sk_Estado_Comparendo) AS sk_Estado_Comparendo
      ,MAX(COALESCE(NUMERO_PLACA,'ND')) AS NUMERO_PLACA
      ,MAX(CGM.DESC_CLASE) AS DESC_CLASE
      ,MAX(CGM.DESC_SERVICIO) AS DESC_SERVICIO
      ,MAX(COBRO_COACTIVO) AS COBRO_COACTIVO
      ,MAX(FECHA_COBRO_COACTIVO) AS FECHA_COBRO_COACTIVO
      ,MAX(COALESCE(P.sk_Persona,-1)) AS sk_Persona
      ,MAX(1 ) AS Sk_Tipo
      ,MAX(CGM.ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
      ,MAX(CGM.DESCRIPCION_COMPARENDO) AS DESCRIPCION_COMPARENDO
      ,MAX(CGM.NOMBRES) AS NOMBRES
      ,MAX(CGM.APELLIDOS) AS APELLIDOS
      ,MAX(CGM.DIRECCION) AS DIRECCION
      ,MAX(CGM.DESC_INFRACCION) AS DESC_INFRACCION
      ,MAX(CGM.TELEFONO) AS TELEFONO
      ,MAX(COALESCE(V.sk_Vehiculo,-1)) AS sk_Vehiculo
	  ,ISNULL(CAST(CONVERT(NVARCHAR(8),MAX(CGM.FECHA_CUOTA),112)AS INTEGER),'19000101') AS Sk_Fecha_Cuota
	  ,MAX(COALESCE(CGM.VALOR_INTERESES_MOROSOS, 0)) AS VALOR_INTERESES_MOROSOS
  FROM [STA_STTM].[dbo].[STA_Fact_Cartera_Generada_Mes] CGM
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON CGM.TIPO_COMPARENDO = TC.Id_Tipo_Comparendo
  --LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112)= F.Sk_Fecha
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON CGM.TIPO_SANCION_MOROSO = TSM.Id_Tipo_sancion_moroso
  LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON CGM.ESTADO_MOROSO = EC.Codigo_Estado_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON CGM.ID_USUARIO_MOROSO = P.Identificacion
  LEFT JOIN DWH_STTM..Dim_Vehiculo V ON V.Placa = CGM.NUMERO_PLACA
WHERE CGM.[ID_CLASE_ORIGEN] = 0
  GROUP BY CONSECUTIVO_MOROSO

COMMIT

BEGIN TRANSACTION

  UPDATE RCM
  SET [ID_CLASE_RECUADO] = 0
  FROM [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RCM

COMMIT

BEGIN TRANSACTION

  UPDATE RC
  SET [ID_CLASE_RECUADO] = 1 --Recaudado con beneficio
  FROM [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RC
  INNER  JOIN STA_STTM..STA_BENEFICIO_CARTERA_MOROSA BCM on RC.CONSECUTIVO_MOROSO = BCM.CONSECUTIVO_MOROSO
   WHERE RC.CONSECUTIVO_MOROSO NOT IN ( 
      SELECT CMANP.CONSECUTIVO_MOROSO
  FROM
  (SELECT CMAN.CONSECUTIVO_MOROSO
   FROM DWH_STTM..Fact_Cartera_Moroso CMAN
   WHERE CMAN.Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
					THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + '12' AS INTEGER)
					ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
					FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and Sk_Tipo in(1,12)
  ) CMANP  
  LEFT JOIN (
  SELECT CMAC.CONSECUTIVO_MOROSO
   FROM DWH_STTM..Fact_Cartera_Moroso CMAC
   WHERE CMAC.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                      FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and Sk_Tipo in(1,12)
  )CMAAP ON  CMANP.CONSECUTIVO_MOROSO = CMAAP.CONSECUTIVO_MOROSO
    WHERE CMAAP.CONSECUTIVO_MOROSO IS NULL)   

COMMIT

BEGIN TRANSACTION
  
  UPDATE RC
  SET [ID_CLASE_RECUADO] = 2 -- recaudado sin beneficio
  FROM [STA_STTM].[dbo].[STA_RECAUDO_CARTERA_MOROSA] RC
   LEFT  JOIN STA_STTM..STA_BENEFICIO_CARTERA_MOROSA BCM on RC.CONSECUTIVO_MOROSO = BCM.CONSECUTIVO_MOROSO
   WHERE RC.CONSECUTIVO_MOROSO NOT IN ( 
      SELECT CMANP.CONSECUTIVO_MOROSO
  FROM
  (SELECT CMAN.CONSECUTIVO_MOROSO
   FROM DWH_STTM..Fact_Cartera_Moroso CMAN
   WHERE CMAN.Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
					THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + '12' AS INTEGER)
					ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
					FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and Sk_Tipo in(1,12)
  ) CMANP  
  LEFT JOIN (
  SELECT CMAC.CONSECUTIVO_MOROSO
   FROM DWH_STTM..Fact_Cartera_Moroso CMAC
   WHERE CMAC.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                      FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and Sk_Tipo in(1,12)
  )CMAAP ON  CMANP.CONSECUTIVO_MOROSO = CMAAP.CONSECUTIVO_MOROSO
    WHERE CMAAP.CONSECUTIVO_MOROSO IS NULL)  AND  BCM.CONSECUTIVO_MOROSO is null

 COMMIT

BEGIN TRANSACTION
  
  INSERT INTO [STA_STTM].[dbo].[STA_Fact_Cartera_Generada_Mes]
           ([ID_MES_CORTE]
           ,[CONSECUTIVO_MOROSO]
           ,[ID_USUARIO_MOROSO]
           ,[NRO_COMPARENDO_MOROSO]
           ,[TIPO_COMPARENDO]
           ,[FECHA_COMPARENDO]
           ,[NUMERO_RES]
           ,[FECHA_RESOLUCION]
           ,[TIPO_SANCION_MOROSO]
           ,[VALOR_MULTA]
           ,[ESTADO_MOROSO]
           ,[DESCRIPCION_ESTADO]
           ,[NUMERO_PLACA]
           ,[DESC_CLASE]
           ,[DESC_SERVICIO]
           ,[COBRO_COACTIVO]
           ,[FECHA_COBRO_COACTIVO]
           ,[DESCRIPCION_COMPARENDO]
           ,[NOMBRES]
           ,[APELLIDOS]
           ,[DIRECCION]
           ,[DESC_INFRACCION]
           ,[TELEFONO]
           ,[ID_TIPO_AJUSTE_MENOR]
           ,[FECHA_CUOTA]
           ,[VALOR_INTERESES_MOROSOS]
           ,[ID_CLASE_ORIGEN])


SELECT (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
						  FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') as [ID_MES_CORTE]
		  ,RCJ.CONSECUTIVO_MOROSO AS [CONSECUTIVO_MOROSO]
		  ,FCM.[ID_USUARIO_MOROSO]
		  ,FCM.[NRO_COMPARENDO_MOROSO]
		  ,FCM.[TIPO_COMPARENDO]
		  ,FCM.[FECHA_COMPARENDO]
		  ,FCM.[NUMERO_RES]
		  ,FCM.[FECHA_RESOLUCION]
		  ,FCM.[TIPO_SANCION_MOROSO]
		  ,RCJ.SUMADEVALOR_LIQUIDA AS [VALOR_MULTA]
		  ,FCM.[ESTADO_MOROSO]
		  ,FCM.[DESCRIPCION_ESTADO]
		  ,FCM.[NUMERO_PLACA]
		  ,FCM.[DESC_CLASE]
		  ,NULL AS [DESC_SERVICIO]
		  ,FCM.[COBRO_COACTIVO]
		  ,FCM.[FECHA_COBRO_COACTIVO]
		  ,FCM.[DESCRIPCION_COMPARENDO]
		  ,FCM.[NOMBRES]
		  ,FCM.[APELLIDOS]
		  ,FCM.[DIRECCION]
		  ,FCM.[DESC_INFRACCION]
		  ,FCM.[TELEFONO]
		  ,NULL AS [ID_TIPO_AJUSTE_MENOR]
		  ,FCM.[FECHA_CUOTA]
		  ,FCM.[VALOR_INTERESES_MOROSOS],
		  2 as [ID_CLASE_ORIGEN]
		FROM STA_STTM..STA_Fact_Cartera_Moroso FCM
		INNER JOIN STA_STTM..STA_RECAUDO_CARTERA_MOROSA RCJ on FCM.[CONSECUTIVO_MOROSO] = RCJ.[CONSECUTIVO_MOROSO]
		WHERE RCJ.[ID_CLASE_RECUADO] = 2 AND FCM.vigente = 'N'  AND 
		FCM.CONSECUTIVO_MOROSO not in (SELECT CONSECUTIVO_MOROSO FROM [STA_STTM].[dbo].[STA_Fact_Cartera_Generada_Mes])

		UNION ALL
		SELECT (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
						  FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') as [ID_MES_CORTE]
		  ,RCJ.CONSECUTIVO_MOROSO AS [CONSECUTIVO_MOROSO]
		  ,FCM.[ID_USUARIO_MOROSO]
		  ,FCM.[NRO_COMPARENDO_MOROSO]
		  ,FCM.[TIPO_COMPARENDO]
		  ,FCM.[FECHA_COMPARENDO]
		  ,FCM.[NUMERO_RES]
		  ,FCM.[FECHA_RESOLUCION]
		  ,FCM.[TIPO_SANCION_MOROSO]
		  ,RCJ.SUMADEVALOR_LIQUIDA + BCM.SUMADEVALOR_BENEFICIO AS [VALOR_MULTA]
		  ,FCM.[ESTADO_MOROSO]
		  ,FCM.[DESCRIPCION_ESTADO]
		  ,FCM.[NUMERO_PLACA]
		  ,FCM.[DESC_CLASE]
		  ,NULL AS [DESC_SERVICIO]
		  ,FCM.[COBRO_COACTIVO]
		  ,FCM.[FECHA_COBRO_COACTIVO]
		  ,FCM.[DESCRIPCION_COMPARENDO]
		  ,FCM.[NOMBRES]
		  ,FCM.[APELLIDOS]
		  ,FCM.[DIRECCION]
		  ,FCM.[DESC_INFRACCION]
		  ,FCM.[TELEFONO]
		  ,NULL AS [ID_TIPO_AJUSTE_MENOR]
		  ,FCM.[FECHA_CUOTA]
		  ,FCM.[VALOR_INTERESES_MOROSOS],
		  1 as [ID_CLASE_ORIGEN]
		FROM STA_STTM..STA_Fact_Cartera_Moroso FCM
		INNER JOIN STA_STTM..STA_RECAUDO_CARTERA_MOROSA RCJ on FCM.[CONSECUTIVO_MOROSO] = RCJ.[CONSECUTIVO_MOROSO]
		INNER  JOIN STA_STTM..STA_BENEFICIO_CARTERA_MOROSA BCM on RCJ.CONSECUTIVO_MOROSO = BCM.CONSECUTIVO_MOROSO
		WHERE RCJ.[ID_CLASE_RECUADO] = 1 AND FCM.vigente = 'N'  AND 
		FCM.CONSECUTIVO_MOROSO not in (SELECT CONSECUTIVO_MOROSO FROM [STA_STTM].[dbo].[STA_Fact_Cartera_Generada_Mes])

COMMIT


/*


se agrega solo cuando se quiere conciliar con  1 de mess
SELECT 
       MAX(CGM.ID_MES_CORTE) AS ID_MES_CORTE
      ,CONSECUTIVO_MOROSO
      ,MAX(ID_USUARIO_MOROSO) AS ID_USUARIO_MOROSO
      ,MAX(NRO_COMPARENDO_MOROSO) AS NRO_COMPARENDO_MOROSO
      ,MAX(Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
      ,MAX(CAST([FECHA_COMPARENDO] AS DATE))FECHA_COMPARENDO
      ,MAX(NUMERO_RES) AS NUMERO_RES
      ,MAX(CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112))AS Sk_Fecha
      ,MAX(TSM.sk_Tipo_sancion_moroso) AS sk_Tipo_sancion_moroso
      ,MAX(VALOR_MULTA) AS VALOR_MULTA
      ,MAX(EC.sk_Estado_Comparendo) AS sk_Estado_Comparendo
      ,MAX(COALESCE(NUMERO_PLACA,'ND')) AS NUMERO_PLACA
      ,MAX(CGM.DESC_CLASE) AS DESC_CLASE
      ,MAX(CGM.DESC_SERVICIO) AS DESC_SERVICIO
      ,MAX(COBRO_COACTIVO) AS COBRO_COACTIVO
      ,MAX(FECHA_COBRO_COACTIVO) AS FECHA_COBRO_COACTIVO
      ,MAX(COALESCE(P.sk_Persona,-1)) AS sk_Persona
      ,MAX(58 ) AS Sk_Tipo
      ,MAX(CGM.ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
      ,MAX(CGM.DESCRIPCION_COMPARENDO) AS DESCRIPCION_COMPARENDO
      ,MAX(CGM.NOMBRES) AS NOMBRES
      ,MAX(CGM.APELLIDOS) AS APELLIDOS
      ,MAX(CGM.DIRECCION) AS DIRECCION
      ,MAX(CGM.DESC_INFRACCION) AS DESC_INFRACCION
      ,MAX(CGM.TELEFONO) AS TELEFONO
      ,MAX(COALESCE(V.sk_Vehiculo,-1)) AS sk_Vehiculo
	  ,ISNULL(CAST(CONVERT(NVARCHAR(8),MAX(CGM.FECHA_CUOTA),112)AS INTEGER),'19000101') AS Sk_Fecha_Cuota
	  ,MAX(COALESCE(CGM.VALOR_INTERESES_MOROSOS, 0)) AS VALOR_INTERESES_MOROSOS
  FROM [STA_STTM].[dbo].[STA_Fact_Cartera_Generada_Mes] CGM
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON CGM.TIPO_COMPARENDO = TC.Id_Tipo_Comparendo
  --LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112)= F.Sk_Fecha
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON CGM.TIPO_SANCION_MOROSO = TSM.Id_Tipo_sancion_moroso
  LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON CGM.ESTADO_MOROSO = EC.Codigo_Estado_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON CGM.ID_USUARIO_MOROSO = P.Identificacion
  LEFT JOIN DWH_STTM..Dim_Vehiculo V ON V.Placa = CGM.NUMERO_PLACA
WHERE CGM.[ID_CLASE_ORIGEN] = 3
  GROUP BY CONSECUTIVO_MOROSO
UNION ALL 
*/

-- consulta para los sk_tipo 60 y 59 actual
BEGIN TRANSACTION


																							
INSERT INTO [DWH_STTM].[dbo].[Fact_Cartera_Moroso]
           ([Id_Mes_Corte]
           ,[Consecutivo_Moroso]
           ,[ID_Usuario_Moroso]
           ,[Nro_Comparendo_Moroso]
           ,[Sk_Tipo_Comparendo]
           ,[Fecha_Comparendo]
           ,[Numero_Res]
           ,[Sk_Fecha]
           ,[sk_Tipo_sancion_moroso]
           ,[Valor_Multa]
           ,[sk_Estado_Comparendo]
           ,[Numero_Placa]
           ,[Desc_Clase]
           ,[Desc_Servi]
           ,[Cobro_Coactivo]
           ,[Fecha_Cobro_Coactivo]
           ,[sk_Persona]
           ,[Sk_Tipo]
           ,[Id_Tipo_Ajuste_Menor]
           ,[Descripcion_Comparendo]
           ,[Nombres]
           ,[Apellidos]
           ,[Direccion]
           ,[Desc_Infraccion]
           ,[Telefono]
            ,[sk_Vehiculo]
           ,[Sk_Fecha_Cuota]
           ,[Valor_Intereses_Morosos]
        )

SELECT 
       MAX(CGM.ID_MES_CORTE) AS ID_MES_CORTE
      ,CONSECUTIVO_MOROSO
      ,MAX(ID_USUARIO_MOROSO) AS ID_USUARIO_MOROSO
      ,MAX(NRO_COMPARENDO_MOROSO) AS NRO_COMPARENDO_MOROSO
      ,MAX(Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
      ,MAX(CAST([FECHA_COMPARENDO] AS DATE))FECHA_COMPARENDO
      ,MAX(NUMERO_RES) AS NUMERO_RES
      ,MAX(CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112))AS Sk_Fecha
      ,MAX(TSM.sk_Tipo_sancion_moroso) AS sk_Tipo_sancion_moroso
      ,MAX(VALOR_MULTA) AS VALOR_MULTA
      ,MAX(EC.sk_Estado_Comparendo) AS sk_Estado_Comparendo
      ,MAX(COALESCE(NUMERO_PLACA,'ND')) AS NUMERO_PLACA
      ,MAX(CGM.DESC_CLASE) AS DESC_CLASE
      ,MAX(CGM.DESC_SERVICIO) AS DESC_SERVICIO
      ,MAX(COBRO_COACTIVO) AS COBRO_COACTIVO
      ,MAX(FECHA_COBRO_COACTIVO) AS FECHA_COBRO_COACTIVO
      ,MAX(COALESCE(P.sk_Persona,-1)) AS sk_Persona
      ,MAX(59 ) AS Sk_Tipo
      ,MAX(CGM.ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
      ,MAX(CGM.DESCRIPCION_COMPARENDO) AS DESCRIPCION_COMPARENDO
      ,MAX(CGM.NOMBRES) AS NOMBRES
      ,MAX(CGM.APELLIDOS) AS APELLIDOS
      ,MAX(CGM.DIRECCION) AS DIRECCION
      ,MAX(CGM.DESC_INFRACCION) AS DESC_INFRACCION
      ,MAX(CGM.TELEFONO) AS TELEFONO
      ,MAX(COALESCE(V.sk_Vehiculo,-1)) AS sk_Vehiculo
	  ,ISNULL(CAST(CONVERT(NVARCHAR(8),MAX(CGM.FECHA_CUOTA),112)AS INTEGER),'19000101') AS Sk_Fecha_Cuota
	  ,MAX(COALESCE(CGM.VALOR_INTERESES_MOROSOS, 0)) AS VALOR_INTERESES_MOROSOS
 FROM [STA_STTM].[dbo].[STA_Fact_Cartera_Generada_Mes] CGM
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON CGM.TIPO_COMPARENDO = TC.Id_Tipo_Comparendo
  --LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112)= F.Sk_Fecha
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON CGM.TIPO_SANCION_MOROSO = TSM.Id_Tipo_sancion_moroso
  LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON CGM.ESTADO_MOROSO = EC.Codigo_Estado_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON CGM.ID_USUARIO_MOROSO = P.Identificacion
  LEFT JOIN DWH_STTM..Dim_Vehiculo V ON V.Placa = CGM.NUMERO_PLACA
WHERE CGM.[ID_CLASE_ORIGEN] = 1
  GROUP BY CONSECUTIVO_MOROSO
UNION alL

SELECT 
       MAX(CGM.ID_MES_CORTE) AS ID_MES_CORTE
      ,CONSECUTIVO_MOROSO
      ,MAX(ID_USUARIO_MOROSO) AS ID_USUARIO_MOROSO
      ,MAX(NRO_COMPARENDO_MOROSO) AS NRO_COMPARENDO_MOROSO
      ,MAX(Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
      ,MAX(CAST([FECHA_COMPARENDO] AS DATE))FECHA_COMPARENDO
      ,MAX(NUMERO_RES) AS NUMERO_RES
      ,MAX(CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112))AS Sk_Fecha
      ,MAX(TSM.sk_Tipo_sancion_moroso) AS sk_Tipo_sancion_moroso
      ,MAX(VALOR_MULTA) AS VALOR_MULTA
      ,MAX(EC.sk_Estado_Comparendo) AS sk_Estado_Comparendo
      ,MAX(COALESCE(NUMERO_PLACA,'ND')) AS NUMERO_PLACA
      ,MAX(CGM.DESC_CLASE) AS DESC_CLASE
      ,MAX(CGM.DESC_SERVICIO) AS DESC_SERVICIO
      ,MAX(COBRO_COACTIVO) AS COBRO_COACTIVO
      ,MAX(FECHA_COBRO_COACTIVO) AS FECHA_COBRO_COACTIVO
      ,MAX(COALESCE(P.sk_Persona,-1)) AS sk_Persona
      ,MAX(60) AS Sk_Tipo
      ,MAX(CGM.ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
      ,MAX(CGM.DESCRIPCION_COMPARENDO) AS DESCRIPCION_COMPARENDO
      ,MAX(CGM.NOMBRES) AS NOMBRES
      ,MAX(CGM.APELLIDOS) AS APELLIDOS
      ,MAX(CGM.DIRECCION) AS DIRECCION
      ,MAX(CGM.DESC_INFRACCION) AS DESC_INFRACCION
      ,MAX(CGM.TELEFONO) AS TELEFONO
      ,MAX(COALESCE(V.sk_Vehiculo,-1)) AS sk_Vehiculo
	  ,ISNULL(CAST(CONVERT(NVARCHAR(8),MAX(CGM.FECHA_CUOTA),112)AS INTEGER),'19000101') AS Sk_Fecha_Cuota
	  ,MAX(COALESCE(CGM.VALOR_INTERESES_MOROSOS, 0)) AS VALOR_INTERESES_MOROSOS
 FROM [STA_STTM].[dbo].[STA_Fact_Cartera_Generada_Mes] CGM
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Comparendo TC ON CGM.TIPO_COMPARENDO = TC.Id_Tipo_Comparendo
  --LEFT JOIN DWH_STTM.dbo.Dim_Fecha F ON CONVERT(VARCHAR(8),CGM.[FECHA_RESOLUCION],112)= F.Sk_Fecha
  LEFT JOIN DWH_STTM.dbo.Dim_Tipo_Sancion_Moroso TSM ON CGM.TIPO_SANCION_MOROSO = TSM.Id_Tipo_sancion_moroso
  LEFT JOIN DWH_STTM.dbo.Dim_Estado_Comparendo EC ON CGM.ESTADO_MOROSO = EC.Codigo_Estado_Comparendo
  LEFT JOIN DWH_STTM.dbo.Dim_Persona P ON CGM.ID_USUARIO_MOROSO = P.Identificacion
  LEFT JOIN DWH_STTM..Dim_Vehiculo V ON V.Placa = CGM.NUMERO_PLACA
WHERE CGM.[ID_CLASE_ORIGEN] IN (2,4) ---track 2 
  GROUP BY CONSECUTIVO_MOROSO



COMMIT









