    <sql>BEGIN TRANSACTION

DELETE FROM DWH_STTM..Fact_Cartera_Moroso_Agregado 
WHERE Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                      FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')
--Id_Mes_Corte = SUBSTRING(CONVERT(VARCHAR(8),GETDATE(),112),1,6)

COMMIT


---CONTRAVENCIONAL

BEGIN TRANSACTION

--Item en blanco de la cartera
--NOVEDADES QUE SUMAN A LA CARTERA MOROSA:
--NOVEDADES QUE RESTAN A LA CARTERA MOROSA:
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 
SELECT (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
        FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') AS Id_Mes_Corte,
      NULL AS  Valor_Multa,
      sk_tipo_Cartera  
FROM dwh_sttm..Dim_Tipo_Cartera CAR
WHERE sk_tipo_Cartera IN (14,16) 



--Ajustes cartera agregregada especiales
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 

SELECT Coalesce(Id_Mes_Corte,(SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')) AS Id_Mes_Corte,
       Coalesce(SUM(CASE WHEN sk_tipo_Cartera = 65 THEN Valor_Multa * -1 ELSE Valor_Multa END ),0 ) Valor_Multa,
       sk_tipo_Cartera    
FROM dwh_sttm..Dim_Tipo_Cartera CAR
  LEFT JOIN DWH_STTM..Fact_Cartera_Moroso Fac
    ON Car.sk_tipo_Cartera = Fac.sk_Tipo
    AND Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')      
WHERE sk_tipo_Cartera IN (58,59,60,61,62,63,64,66) 
GROUP BY Id_Mes_Corte, sk_tipo_Cartera

UPDATE DWH_STTM.dbo.Fact_Cartera_Moroso_Agregado 
SET Valor_Multa = 0 
WHERE Id_Mes_Corte= 202102 and sk_Tipo in (64,61,66) 
AND Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 


UPDATE DWH_STTM.dbo.Fact_Cartera_Moroso_Agregado 
SET Valor_Multa = 0 
WHERE Id_Mes_Corte= 202103 and sk_Tipo in (64,61,63,66) 
AND Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 



UPDATE DWH_STTM.dbo.Fact_Cartera_Moroso_Agregado 
SET Valor_Multa = Valor_multa - 72842767
WHERE Id_Mes_Corte= 202407 and sk_Tipo in (61) 
AND Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 


