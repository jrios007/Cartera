  SUM(valor_multa) AS Valor_Multa, 
  43 as Sk_Tipo 
 from dwh_sttm..Fact_Cartera_Moroso
where  Sk_tipo IN (1,12)
  AND ID_MES_CORTE = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
