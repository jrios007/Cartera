--Ajuste por menor valor a actos administrativos ya reportados en cartera (actos administrativos en firme 

INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 

SELECT Coalesce(Id_Mes_Corte,(SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')) AS Id_Mes_Corte,
       Coalesce(SUM(Valor_Multa),0 ) Valor_Multa,
       sk_tipo_Cartera  
FROM dwh_sttm..Dim_Tipo_Cartera CAR
  LEFT JOIN DWH_STTM..Fact_Cartera_Moroso Fac
    ON Car.sk_tipo_Cartera = Fac.Sk_Tipo 
    
    AND fac.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
WHERE sk_tipo_Cartera IN (9)

GROUP BY Id_Mes_Corte, sk_tipo_Cartera	


COMMIT


update Fact_Cartera_Moroso_Agregado set Valor_Multa = 
 (select case when sum(fcm.valor_multa) &lt; fca.valor_9 then fca.valor_9 - sum(fcm.valor_multa)  else 0 end 
from Fact_Cartera_Moroso fcm
left join (select fca.Id_Mes_Corte, sum(fca.Valor_Multa) as valor_9 from Fact_Cartera_Moroso fca 
where fca.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')  and fca.Sk_Tipo = (9)
group by id_mes_corte) fca  on fca.Id_Mes_Corte = fcm.Id_Mes_Corte 
where fcm.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and fcm.Sk_Tipo in (2)
group by fcm.Id_Mes_Corte, fca.valor_9
)
where Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and Sk_Tipo in (9)



BEGIN TRANSACTION 



--Saldo acuerdos pago de morosos meses anteriores -- 0.2

INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 
SELECT 
 (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') AS Id_Mes_Corte, 
  SUM(valor_multa) AS Valor_Multa, 
  13 as Sk_Tipo 
  FROM dwh_sttm..fact_cartera_moroso_agregado 
  WHERE Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
							THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + '12' AS INTEGER)
							ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
   							FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
  AND sk_tipo IN (19)
  GROUP BY Id_Mes_Corte
  
/*
UPDATE DWH_STTM.dbo.Fact_Cartera_Moroso_Agregado 
SET Valor_Multa =  4256907713
WHERE Id_Mes_Corte= 202102 and sk_Tipo = 13 AND Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
*/



 -- CARTERA MOROSOS
-- Saldo Cartera del mes anterior (0,1 + 0,2) -- 1.0
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 
  SELECT Id_Mes_Corte , 
  SUM(valor_multa) AS Valor_Multa, 
  20 as Sk_Tipo 
  FROM dwh_sttm..fact_cartera_moroso_agregado 
  WHERE Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                          FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
  AND sk_tipo IN (12,13)
  GROUP BY Id_Mes_Corte 

-- TOTAL CARTERA MOROSA GENERADA (0.1+2.1+2.2) -- 3
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 
  SELECT Id_Mes_Corte, 
  SUM(valor_multa) AS Valor_Multa, 
  15 as Sk_Tipo 
  FROM dwh_sttm..fact_cartera_moroso_agregado 
  WHERE id_mes_corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                          FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')  
  AND sk_tipo IN (12,1,2,58,59,60,65)
  GROUP BY Id_Mes_Corte


-- TOTAL NOVEDADES QUE RESTAN 4 al 11 -- 12
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 
  SELECT Id_Mes_Corte , 
  SUM(valor_multa) AS Valor_Multa, 
  17 as Sk_Tipo 
  FROM dwh_sttm..fact_cartera_moroso_agregado 
  WHERE Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                         FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')   
  --AND sk_tipo IN (4, 5, 6, 7, 8, 9, 10, 11, 42,54)
  --AND sk_tipo IN (4,54,63,64,5,6,7,8,9,10,11,42,17) --61,62, anterior a beneficio ley 2055
  AND sk_tipo IN (4,54,67,63,64,5,6,7,8,9,10,11,42,17,61,66)
  GROUP BY Id_Mes_Corte
 
  
-- SALDO CARTERA MOROSA DEL MES (3 - 12) -- 13
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 
SELECT TR.id_mes_corte AS Id_Mes_Corte, 
        TR.tres - DO.doce as Valor_Multa, 
        21 AS Sk_Tipo 
FROM 
 ( SELECT Id_Mes_Corte, SUM(Valor_Multa) as tres
    FROM dwh_sttm..fact_cartera_moroso_agregado 
    WHERE id_mes_corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')    
    AND sk_tipo = 15
    GROUP BY Id_Mes_Corte
  ) TR
INNER JOIN 
  (SELECT Id_Mes_Corte, SUM(Valor_Multa) as doce
    FROM dwh_sttm..fact_cartera_moroso_agregado 
    WHERE id_mes_corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')    
    AND sk_tipo = 17
     GROUP BY Id_Mes_Corte
  ) DO
ON TR.id_mes_corte = DO.id_mes_corte


--SALDO PAGO MOROSO GENERADO AL MES ACTUAL -- 14 
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
	(Id_Mes_Corte, Valor_Multa, Sk_Tipo)
SELECT 
 (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER)AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') as  Id_Mes_Corte,
  (SUM(SALDO_AP) - SUM(SALDO_AP_INT)) AS SALDO_AP_COMP_Y_MOROSOS,
  Sk_Tipo_Cartera 
  FROM dwh_sttm..Dim_Tipo_Cartera CAR
	LEFT JOIN dwh_sttm..Fact_Cartera_Acuerdos_Generados_Mes_Actual  MA
		ON CAR.Sk_Tipo_Cartera = MA.Sk_tipo
  WHERE Sk_tipo IN (19)
  AND ID_MES_CORTE = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
  GROUP BY Sk_Tipo_Cartera



