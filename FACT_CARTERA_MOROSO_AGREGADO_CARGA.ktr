	UPDATE STA_Def
		SET STA_Def.VALOR_INTERESES_MOROSOS = backInteres.VALOR_INTERES
	FROM  [DWH_STTM].[dbo].[Fact_Cartera_Moroso] STA_Def
	INNER JOIN STA_STTM..INTERESES_MOROSOS_BACKUP backInteres
		ON STA_Def.CONSECUTIVO_MOROSO = backInteres.CONSECUTIVO_MOROSOS AND backInteres.ID_MES_CORTE =  STA_Def.ID_MES_CORTE
	WHERE backInteres.ID_MES_CORTE = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_fin,112),1,6)  AS INTEGER) AS ID_Mes_Corte
										  FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')
	AND STA_Def.VALOR_INTERESES_MOROSOS IS NULL OR STA_Def.VALOR_INTERESES_MOROSOS = 0 AND backInteres.VALOR_INTERES>0
 
COMMIT
