--Items que vienen desde la tabla general de cartera
  --Saldo Morosos Al Mes Anterior
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 

SELECT (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                             FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') AS Id_Mes_Corte,
     Coalesce(SUM(Valor_Multa),0 ) Valor_Multa,
12 AS sk_tipo_Cartera  
FROM dwh_sttm..Dim_Tipo_Cartera CAR
LEFT JOIN DWH_STTM..Fact_Cartera_Moroso_Agregado Fac
ON Car.sk_tipo_Cartera = Fac.sk_Tipo
AND Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
					THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + '12' AS INTEGER)
			ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
		FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')      
WHERE sk_tipo_Cartera IN (21)
GROUP BY  sk_tipo_Cartera


--Items que vienen desde la tabla general de cartera
  --Cartera generada en el mes (soporte actos administrativos en firme y no pagados en el mes)
  
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 

SELECT Coalesce(Id_Mes_Corte,(SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')) AS Id_Mes_Corte,
       Coalesce(SUM(Valor_Multa),0 ) Valor_Multa,
       sk_tipo_Cartera    
FROM dwh_sttm..Dim_Tipo_Cartera CAR
  LEFT JOIN DWH_STTM..Fact_Cartera_Moroso Fac
    ON Car.sk_tipo_Cartera = Fac.sk_Tipo
    AND Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')      
WHERE sk_tipo_Cartera IN (1) 
GROUP BY Id_Mes_Corte, sk_tipo_Cartera



--Ajustes por mayor valor a los actos administrativos ya reportados en cartera
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 

SELECT Coalesce(Id_Mes_Corte,(SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')) AS Id_Mes_Corte,
       Coalesce(SUM(Valor_Multa),0 ) Valor_Multa,
       sk_tipo_Cartera    
FROM dwh_sttm..Dim_Tipo_Cartera CAR
  LEFT JOIN DWH_STTM..Fact_Cartera_Moroso Fac
    ON Car.sk_tipo_Cartera = Fac.sk_Tipo
    AND Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')      
WHERE sk_tipo_Cartera IN (2) 
GROUP BY Id_Mes_Corte, sk_tipo_Cartera


--sedan

update Fact_Cartera_Moroso_Agregado set Valor_Multa = 
 (select case when sum(fcm.valor_multa)> fca.valor_9 then sum(fcm.valor_multa) -  fca.valor_9 else 0 end 
from Fact_Cartera_Moroso fcm
left join (select fca.Id_Mes_Corte, sum(fca.Valor_Multa) as valor_9 from Fact_Cartera_Moroso fca 
where fca.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')  and fca.Sk_Tipo = (9)
group by id_mes_corte) fca  on fca.Id_Mes_Corte = fcm.Id_Mes_Corte 
where fcm.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and fcm.Sk_Tipo in (2)
group by fcm.Id_Mes_Corte, fca.valor_9
)
where Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') and Sk_Tipo in (2)

--sedan



