--Items que vienen desde la tabla general de cartera
  --Recaudo de cartera  morosa de meses anteriores (4016-0200) incluye cobro coactivo
  --Morosos meses anteriores, que celebran acuerdos de pago mes actual
  --Pagos a través del SIMIT de cartera morosa  (externo - AV-VILLAS)
  --Actos administrativos y fallo judicial que revocan multas impuestas, ya causadas
  --Prescripciones de cartera  otorgadas en el mes
  --Exenciones legales (Ley y Acuerdos)
  --Devoluciones morosas generadas de morosos meses anteriores
  --Otras novedades
  --Saldo acuerdos pago generados al mes actual
INSERT INTO dwh_sttm..fact_cartera_moroso_agregado 
(Id_Mes_Corte, Valor_Multa, Sk_Tipo) 

SELECT Coalesce(Id_Mes_Corte,(SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones')) AS Id_Mes_Corte,
       Coalesce(SUM(Valor_Multa),0 ) Valor_Multa,
       sk_tipo_Cartera  
FROM dwh_sttm..Dim_Tipo_Cartera CAR
  LEFT JOIN DWH_STTM..Fact_Cartera_Moroso Fac
    ON Car.sk_tipo_Cartera = Fac.sk_Tipo --OR Car.sk_tipo_Cartera = Fac.Id_Tipo_Ajuste_Menor
        AND fac.Id_Mes_Corte = (SELECT CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) AS ID_Mes_Corte
                           FROM dwh_sttm..Dim_Parametros WHERE id_Param = 'Cartera_Contravenciones') 
WHERE sk_tipo_Cartera IN (4,5,6,7,8,10,11,42,54,67)
GROUP BY Id_Mes_Corte, sk_tipo_Cartera

UPDATE DWH_STTM.dbo.Fact_Cartera_Moroso_Agregado 
