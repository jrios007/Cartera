      <yloc>410</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>SOLICITUD_DETALLE_CONTRAV </name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>qxtransito</connection>
    <sql>SELECT SOLICITUD_MAESTRO.NRO_TRAMITE,
  SOLICITUD_MAESTRO.NRO_RECIBO,
  SOLICITUD_MAESTRO.ESTADO_RECIBO,
  SOLICITUD_MAESTRO.FECHA_LIQUIDA,
  SOLICITUD_MAESTRO.IDENTIFICADOR_SOLICITUD,
  SOLICITUD_MAESTRO.ID_PUNTO_ATENCION,
  SOLICITUD_MAESTRO.ID_ESTADO_SOLICITUD,
  SOLICITUD_DETALLE_CONTRAV.CONSECUTIVO_MOROSOS,
  MOROSOS.CONSECUTIVO_MOROSOS AS CONSECUTIVO_MOROSOS_2,
  MOROSOS.NUMERO_RES,
  MOROSOS.FECHA_RESOLUCION,
  MOROSOS.VALOR_MULTA,
  MOROSOS.FECHA_GENERACION,
  MOROSOS.POLCA,
  MOROSOS.COBRO_COACTIVO,
  MOROSOS.FECHA_COBRO_COACTIVO,
  SUM(SOLICITUD_DETALLE_CONTRAV.VALOR_LIQUIDA) AS VALOR_LIQUIDA
FROM (SOLICITUD_MAESTRO
INNER JOIN SOLICITUD_DETALLE_CONTRAV
ON SOLICITUD_MAESTRO.NRO_TRAMITE = SOLICITUD_DETALLE_CONTRAV.NRO_TRAMITE
INNER JOIN MOROSOS
ON SOLICITUD_DETALLE_CONTRAV.CONSECUTIVO_MOROSOS = MOROSOS.CONSECUTIVO_MOROSOS)
LEFT JOIN
    (
    SELECT MOROSOS.CONSECUTIVO_MOROSOS
    FROM (SOLICITUD_MAESTRO
      INNER JOIN SOLICITUD_DETALLE_CONTRAV
      ON SOLICITUD_MAESTRO.NRO_TRAMITE = SOLICITUD_DETALLE_CONTRAV.NRO_TRAMITE)
      INNER JOIN MOROSOS
      ON SOLICITUD_DETALLE_CONTRAV.CONSECUTIVO_MOROSOS = MOROSOS.CONSECUTIVO_MOROSOS
    WHERE (((SOLICITUD_MAESTRO.NRO_RECIBO)          &lt;&gt;'0')
      AND ((SOLICITUD_MAESTRO.ESTADO_RECIBO) ='1' Or (SOLICITUD_MAESTRO.ESTADO_RECIBO) ='2'  Or (SOLICITUD_MAESTRO.ESTADO_RECIBO) ='3')
      AND ((SOLICITUD_MAESTRO.FECHA_LIQUIDA) Between TO_DATE(?,'YYYYMMDD HH24:MI:SS') AND TO_DATE(?,'YYYYMMDD HH24:MI:SS'))
      AND ((SOLICITUD_MAESTRO.ID_PUNTO_ATENCION)   ='98')
      AND ((SOLICITUD_DETALLE_CONTRAV.CONSECUTIVO_MOROSOS) Is Not Null)
      AND ((MOROSOS.FECHA_GENERACION)  Between TO_DATE(?,'YYYYMMDD HH24:MI:SS') AND TO_DATE(?,'YYYYMMDD HH24:MI:SS'))
    )) AUX ON MOROSOS.CONSECUTIVO_MOROSOS = AUX.CONSECUTIVO_MOROSOS
WHERE ((SOLICITUD_MAESTRO.NRO_RECIBO          &lt;&gt;'0')
  AND SOLICITUD_MAESTRO.ESTADO_RECIBO           ='1'
  Or SOLICITUD_MAESTRO.ESTADO_RECIBO             ='2'
  Or SOLICITUD_MAESTRO.ESTADO_RECIBO             ='3')
  AND ((SOLICITUD_MAESTRO.FECHA_LIQUIDA)  Between TO_DATE(?,'YYYYMMDD HH24:MI:SS') AND TO_DATE(?,'YYYYMMDD HH24:MI:SS') )
  AND ((SOLICITUD_MAESTRO.ID_PUNTO_ATENCION)            ='98')
  AND ((SOLICITUD_DETALLE_CONTRAV.CONSECUTIVO_MOROSOS) Is Not Null)
  --AND AUX.CONSECUTIVO_MOROSOS IS NULL esta opcion excluye registros pagados por simit
GROUP BY SOLICITUD_MAESTRO.NRO_TRAMITE,
  SOLICITUD_MAESTRO.NRO_RECIBO,
  SOLICITUD_MAESTRO.ESTADO_RECIBO,
  SOLICITUD_MAESTRO.FECHA_LIQUIDA,
  SOLICITUD_MAESTRO.IDENTIFICADOR_SOLICITUD,
  SOLICITUD_MAESTRO.ID_PUNTO_ATENCION,
  SOLICITUD_MAESTRO.ID_ESTADO_SOLICITUD,
  SOLICITUD_DETALLE_CONTRAV.CONSECUTIVO_MOROSOS,
  MOROSOS.CONSECUTIVO_MOROSOS,
  MOROSOS.NUMERO_RES,
  MOROSOS.FECHA_RESOLUCION,
  MOROSOS.VALOR_MULTA,
  MOROSOS.FECHA_GENERACION,
  MOROSOS.POLCA,
  MOROSOS.COBRO_COACTIVO,
  MOROSOS.FECHA_COBRO_COACTIVO</sql>
    <limit>0</limit>
    <lookup>INFO_PARAMETROS</lookup>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>250</xloc>
      <yloc>560</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
