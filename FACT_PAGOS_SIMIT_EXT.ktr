  <step>
    <name>PARAMETROS</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DWH_STTM</connection>
    <sql>SELECT
CONVERT(nvarchar(8),fecha_inicio,112) + ' ' + '00:00:00' AS fecha_inicial,
CONVERT(nvarchar(8),fecha_fin,112) + ' ' + '23:59:59' AS fecha_final,
CONVERT(nvarchar(8),fecha_inicio,112) + ' ' + '00:00:00' AS fecha_inicial1,
CONVERT(nvarchar(8),fecha_fin,112) + ' ' + '23:59:59' AS fecha_final1,
CONVERT(nvarchar(8),fecha_inicio,112) + ' ' + '00:00:00' AS fecha_inicial2,
CONVERT(nvarchar(8),fecha_fin,112) + ' ' + '23:59:59' AS fecha_final2
FROM DIM_PARAMETROS
WHERE ID_PARAM='Cartera_Contravenciones'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
