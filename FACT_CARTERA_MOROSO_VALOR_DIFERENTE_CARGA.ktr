  <step>
    <name>STA_Fact_Cartera_Moroso </name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>STA_STTM</connection>
    <sql>
SELECT DISTINCT
  Id_Mes_Corte = (SELECT CAST(CONVERT(VARCHAR(6),fecha_fin,112) AS INT )  
				  FROM DWH_STTM..Dim_Parametros WHERE Id_param = &apos;Cartera_Contravenciones&apos;)
, SCM.CONSECUTIVO_MOROSO
, MAX(SCM.[ID_USUARIO_MOROSO]) AS [ID_USUARIO_MOROSO]
, MAX(SCM.[NRO_COMPARENDO_MOROSO]) AS [NRO_COMPARENDO_MOROSO]
, MAX(CM.Sk_Tipo_Comparendo) AS Sk_Tipo_Comparendo
, MAX(SCM.[FECHA_COMPARENDO]) AS [FECHA_COMPARENDO]
, MAX(SCM.[NUMERO_RES]) AS [NUMERO_RES]
, MAX(Sk_Fecha) AS [FECHA_RESOLUCION]
, MAX(sk_Tipo_sancion_moroso) AS TIPO_SANCION_MOROSO
, MAX(ABS(SCM.[VALOR_MULTA] - CM.VALOR_MULTA)) AS VALOR_MULTA
, MAX(sk_Estado_Comparendo) AS [ESTADO_MOROSO]
, MAX(COALESCE(SCM.[NUMERO_PLACA],&apos;ND&apos;)) AS NUMERO_PLACA
, MAX(SCM.[DESC_CLASE]) AS [DESC_CLASE]
, MAX(SCM.DESC_SERVI) AS DESC_SERVI
, MAX(COALESCE(SCM.[COBRO_COACTIVO],&apos;ND&apos;)) AS [COBRO_COACTIVO]
, MAX(COALESCE(SCM.[FECHA_COBRO_COACTIVO],&apos;1900-01-01&apos;)) AS [FECHA_COBRO_COACTIVO]
, MAX(COALESCE(sk_Persona,-1)) AS sk_Persona
, Sk_Tipo = CASE WHEN SCM.[VALOR_MULTA] &lt; CM.Valor_Multa THEN 9 ELSE 2 END 
, MAX(CM.ID_TIPO_AJUSTE_MENOR) AS ID_TIPO_AJUSTE_MENOR
, MAX(SCM.DESCRIPCION_COMPARENDO) AS DESCRIPCION_COMPARENDO
, MAX(SCM.NOMBRES) AS NOMBRES
, MAX(SCM.APELLIDOS) AS APELLIDOS
, MAX(SCM.DIRECCION) AS DIRECCION
, MAX(SCM.DESC_INFRACCION) AS DESC_INFRACCION
, MAX(SCM.TELEFONO) AS TELEFONO
, MAX(COALESCE(CM.Sk_Vehiculo,-1)) AS Sk_Vehiculo
  FROM [DWH_STTM].[dbo].[Fact_Cartera_Moroso] CM
  INNER JOIN STA_STTM.dbo.STA_Fact_Cartera_Moroso SCM 
	ON SCM.Consecutivo_Moroso = CM.Consecutivo_Moroso
	AND Id_Mes_Corte = (SELECT CASE WHEN (CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),5,2)  AS INTEGER)) -1 = 0 
                            THEN CAST( CAST( CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,4)  AS INTEGER) - 1 AS VARCHAR(4)) + &apos;12&apos; AS INTEGER)
                            ELSE  CAST(SUBSTRING(CONVERT(VARCHAR(8),Fecha_Inicio,112),1,6)  AS INTEGER) -1	END AS ID_Mes_Corte
                              FROM dwh_sttm..Dim_Parametros WHERE id_Param = &apos;Cartera_Contravenciones&apos;)
   AND Sk_Tipo IN (1,12)
  WHERE CM.Valor_Multa &lt;&gt; SCM.[VALOR_MULTA] 
	and scm.vigente = &apos;S&apos;
  GROUP BY SCM.CONSECUTIVO_MOROSO,CASE WHEN SCM.[VALOR_MULTA] &lt; CM.Valor_Multa THEN 9 ELSE 2 END
  	 



</sql>
